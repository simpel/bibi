{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@bibi/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@bibi/ui",
        "storybook",
        "--no-open"
      ],
      "port": 6006
    },
    {
      "name": "mcp",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@bibi/mcp",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "web-e2e",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "E2E_MOCK_MODEL=1",
        "pnpm",
        "--filter",
        "@bibi/web",
        "dev"
      ],
      "port": 3000
    }
  ]
}
