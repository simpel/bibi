{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["transit", "^build", "@bibi/db#generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "build-storybook": {
      "dependsOn": ["transit"],
      "outputs": ["storybook-static/**"]
    },
    "//#lint": {
      "cache": false
    },
    "//#check:structure": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["transit", "^build", "@bibi/db#generate"]
    },
    "test": {
      "dependsOn": ["transit", "^build", "@bibi/db#generate", "@bibi/db#migrate:test"],
      "cache": false
    },
    "generate": {
      "cache": false
    },
    "migrate:test": {
      "cache": false
    },
    "migrate": {
      "cache": false
    },
    "seed:skills": {
      "dependsOn": ["@bibi/db#generate", "@bibi/db#migrate"],
      "cache": false
    },
    "seed:demo": {
      "dependsOn": ["@bibi/db#generate", "@bibi/db#migrate"],
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "SMTP_URL",
    "MAIL_FROM",
    "MAIL_PROVIDER",
    "RESEND_API_KEY",
    "RESEND_WEBHOOK_SECRET",
    "AI_GATEWAY_API_KEY",
    "WEB_ORIGIN",
    "MCP_ORIGIN",
    "WEB_PORT",
    "STORYBOOK_PORT",
    "STORYBOOK_URL",
    "WEB_OAUTH_CLIENT_ID",
    "NODE_ENV",
    "E2E_MOCK_MODEL",
    "LOG_LEVEL",
    "LOG_FORMAT",
    "SYSTEM_LOG_RETENTION_DAYS",
    "AUDIT_LOG_PSEUDONYMISE_AFTER_DAYS"
  ]
}
