{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "generate": {
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "SMTP_URL",
    "MAIL_FROM",
    "MAIL_PROVIDER",
    "RESEND_API_KEY",
    "RESEND_WEBHOOK_SECRET",
    "AI_GATEWAY_API_KEY",
    "WEB_URL",
    "MCP_URL",
    "WEB_PORT",
    "WEB_OAUTH_CLIENT_ID",
    "NODE_ENV",
    "E2E_MOCK_MODEL",
    "LOG_LEVEL",
    "LOG_FORMAT",
    "SYSTEM_LOG_RETENTION_DAYS",
    "AUDIT_LOG_PSEUDONYMISE_AFTER_DAYS"
  ]
}
