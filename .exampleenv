# Rename to .env.example (tracked template) or copy to .env and fill in.
# Read only through @okazi/config (never process.env in app code).

# --- Database (docker compose: postgres) ---
DATABASE_URL=postgresql://okazi:okazi@localhost:5432/okazi

# --- Better Auth ---
# Generate with: openssl rand -base64 32   (min 32 chars)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Mail (docker compose: mailpit; SMTP 1025, UI http://localhost:8025) ---
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Okazi <no-reply@okazi.local>
# Adapter (ADR 0012): smtp (default, uses SMTP_URL) or resend (production, needs RESEND_API_KEY).
MAIL_PROVIDER=smtp
RESEND_API_KEY=
# Signing secret (whsec_...) of the Resend email.received webhook.
RESEND_WEBHOOK_SECRET=
# Inbound subdomain for booking reply addresses, e.g. in.okazi.se (docs/runbooks/inbound-email.md).
MAIL_INBOUND_DOMAIN=

# --- App URLs / ports ---
WEB_URL=http://localhost:3000
MCP_URL=http://localhost:3001
PORT=3001

# --- AI (Vercel AI Gateway) ---
# Unset = deterministic placeholder embedder in dev; the chat model needs a real key.
# Models are NOT configured here: a platform admin chooses them in /admin/ai-models (ADR 0015).
AI_GATEWAY_API_KEY=

# --- Assistant OAuth client ---
# Printed by: pnpm --filter @okazi/web provision:oauth   (read by web and mcp)
WEB_OAUTH_CLIENT_ID=

# --- Optional ---
# API key for the stdio MCP server
OKAZI_API_KEY=
# E2E only: scripted mock chat model. Ignored when NODE_ENV=production.
E2E_MOCK_MODEL=false
# System log (ADR 0014). Level: trace|debug|info|warn|error|fatal|silent (default info, silent in tests).
# Format: json|pretty (default json in production, pretty otherwise).
LOG_LEVEL=
LOG_FORMAT=
# Days the SystemLog table (admin view) keeps rows. Default 30.
SYSTEM_LOG_RETENTION_DAYS=
# Days before personal values in AuditLog before/after are redacted by the worker (ADR 0032). Default 365.
AUDIT_LOG_PSEUDONYMISE_AFTER_DAYS=
PW_CHROMIUM_PATH=/Users/joelsanden/Library/Caches/ms-playwright/chromium-1223/chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing

# Stripe Connect (ADR 0028): platform secret key and the platform account id. Payment operations
# answer UNAVAILABLE until both are set.
STRIPE_SECRET_KEY=
STRIPE_PLATFORM_ACCOUNT_ID=
# Okazi's application fee in basis points of each payment (250 = 2.5 %); empty = no fee.
STRIPE_APPLICATION_FEE_BPS=
