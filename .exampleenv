# Copy to .env in the repo root and fill in. Web, worker, scripts and tests all read that one file.
# Read only through @bibi/config (never process.env in app code). Production keys live in Coolify,
# not here; every key the app reads must also be listed in docker-compose.prod.yml (x-app-env).
# Use test values only: Stripe sandbox, Visma sandbox, the Swish simulator.
# Empty `KEY=` lines are dropped when `pnpm wt:new` copies this file; a commented line is optional.

# --- Database (docker compose: postgres) ---
DATABASE_URL=postgresql://bibi:bibi@localhost:5432/bibi
# Connections per process (web and worker each open one pool; ADR 0097). Default 10.
# DATABASE_POOL_MAX=10

# --- Auth (Better Auth) ---
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3330

# --- Origins and ports. *_ORIGIN is scheme://host[:port] with no path; *_URL is used as written;
# *_BASE_URL is an API root. ---
WEB_ORIGIN=http://localhost:3330
# MCP's origin; its endpoint is <MCP_ORIGIN>/mcp, served by the web app (ADR 0104). Unset = WEB_ORIGIN.
# Production: https://mcp.heybibi.se
# MCP_ORIGIN=
# Public site on its own host (ADR 0073). Unset locally: one host serves everything.
# PUBLIC_ORIGIN=
# Dev server ports; `pnpm wt:new` sets them per worktree.
# WEB_PORT=3330
# STORYBOOK_PORT=3332
# STORYBOOK_URL=http://localhost:3332

# --- Mail (docker compose: mailpit; SMTP 1025, inbox http://localhost:8025) ---
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Bibi <no-reply@bibi.local>
# smtp (default) or resend (needs RESEND_API_KEY; ADR 0012).
MAIL_PROVIDER=smtp
RESEND_API_KEY=
# Signing secret (whsec_...) of the Resend inbound webhook.
RESEND_WEBHOOK_SECRET=
# Inbound subdomain for order reply addresses, e.g. in.heybibi.se (docs/runbooks/inbound-email.md).
MAIL_INBOUND_DOMAIN=
# Address shown on /support. Unset: the page points to the assistant and admins only.
# SUPPORT_EMAIL=

# --- File storage (ADR 0063; MinIO in docker compose, `pnpm docker:up` creates the bucket) ---
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=bibi-files
S3_ACCESS_KEY=bibi
S3_SECRET_KEY=bibi-minio-dev
# Disk adapter instead: STORAGE_DRIVER=disk and this root (relative to the repo).
# STORAGE_DISK_DIR=./.storage

# --- AI (Vercel AI Gateway) ---
# Unset = placeholder embedder; the chat needs a real key. Models are chosen in /admin/ai-models.
AI_GATEWAY_API_KEY=
# Assistant OAuth client, printed by: pnpm --filter @bibi/web provision:oauth
WEB_OAUTH_CLIENT_ID=
# API key for the stdio MCP server (apps/mcp run on its own).
# BIBI_API_KEY=

# --- Integrations (ADR 0100). Venues connect their own accounts in Administration → Integrations;
# these are Bibi's own app keys. A provider without its keys shows as Unavailable. ---
# Seals integration tokens at rest (ADR 0087): openssl rand -base64 32. Unset: nothing can connect.
INTEGRATION_SECRET_KEY=
# Stripe Connect (ADR 0028), sandbox: sk_test_..., acct_..., and `stripe listen` prints the whsec_.
STRIPE_SECRET_KEY=
STRIPE_PLATFORM_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=
# Bibi's fee in basis points of each payment (250 = 2.5 %). Unset: no fee.
# STRIPE_APPLICATION_FEE_BPS=
# Fortnox app (ADR 0087); redirect URI: <WEB_ORIGIN>/api/integrations/fortnox/callback.
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
# Visma eEkonomi app (ADR 0100); redirect URI: <WEB_ORIGIN>/api/providers/visma/callback.
VISMA_CLIENT_ID=
VISMA_CLIENT_SECRET=
VISMA_IDENTITY_BASE_URL=https://identity-sandbox.test.vismaonline.com
VISMA_API_BASE_URL=https://eaccountingapi-sandbox.test.vismaonline.com
# Swish: unset = the Merchant Swish Simulator. Production: https://cpc.getswish.net/swish-cpcapi.
# SWISH_API_BASE_URL=

# --- Logging (ADR 0014, 0031) ---
# trace|debug|info|warn|error|fatal|silent (default info, silent in tests); json|pretty.
# LOG_LEVEL=info
# LOG_FORMAT=pretty
# Better Stack log shipping; both or neither.
# BETTER_STACK_HOST=
# BETTER_STACK_SOURCE_TOKEN=
# Days SystemLog keeps rows (default 30) and before AuditLog values are redacted (default 365).
# SYSTEM_LOG_RETENTION_DAYS=30
# AUDIT_LOG_PSEUDONYMISE_AFTER_DAYS=365

# --- Tooling (not read by the app) ---
# Separate test database; default <db>_test.
# TEST_DATABASE_URL=
# Coolify tunnel (tools/server/coolify-tunnel.sh): the server's IP and the local port.
# COOLIFY_HOST=
# COOLIFY_PORT=8000
