{
  "name": "okazi",
  "private": true,
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:structure": "node tools/check-structure.mjs",
    "db:migrate": "pnpm --filter @okazi/db migrate",
    "test:db": "pnpm --filter @okazi/db migrate:test",
    "db:generate": "pnpm --filter @okazi/db generate",
    "gen": "node tools/gen.mjs",
    "wt:new": "tools/worktree/new.sh",
    "wt:rm": "tools/worktree/rm.sh",
    "wt:list": "tools/worktree/list.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.8",
    "typescript": "7.0.2"
  }
}
