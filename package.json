{
  "name": "okazi",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:structure": "node tools/check-structure.mjs",
    "db:migrate": "pnpm --filter @okazi/db migrate",
    "db:generate": "pnpm --filter @okazi/db generate",
    "gen": "node tools/gen.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.8",
    "typescript": "7.0.2"
  }
}
