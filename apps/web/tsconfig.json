{
  "extends": "@okazi/config/tsconfig.next.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@core-schema/venue": ["../../packages/core/src/features/venue/schema.ts"],
      "@core-schema/room": ["../../packages/core/src/features/room/schema.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src",
    "e2e",
    "scripts",
    "*.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
