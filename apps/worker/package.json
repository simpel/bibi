{
  "name": "@okazi/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@okazi/config": "workspace:*",
    "@okazi/core": "workspace:*",
    "@okazi/db": "workspace:*",
    "@okazi/logger": "workspace:*",
    "@paralleldrive/cuid2": "3.3.0",
    "pg-boss": "12.38.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
