{
  "name": "@okazi/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas.ts",
    "./seed": "./src/skills/seed-system-skills.ts",
    "./seed/demo": "./src/seed/demo/seed-demo.ts",
    "./pipeline-setup-templates": "./src/features/pipeline-setup/draft-from-templates.ts",
    "./setup-presets": "./src/templates/setup-presets/setup-presets.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:skills": "tsx --env-file-if-exists=../../.env src/skills/seed-cli.ts",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/seed/demo/seed-cli.ts",
    "cleanup:test-orgs": "tsx --env-file-if-exists=../../.env src/seed/demo/cleanup-cli.ts"
  },
  "dependencies": {
    "@okazi/config": "workspace:*",
    "@okazi/db": "workspace:*",
