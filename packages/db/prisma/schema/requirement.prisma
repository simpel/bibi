/// Requirement – a count against a list value on a order (ADR 0021), e.g. Gluten × 3 or
/// Wheelchair × 2. Without `lineId` it applies to the whole order; with one it applies to
/// that line and replaces the order's count for the same value there. Its type (base
/// `REQUIREMENT`) decides its own fields, e.g. Severity. Never linked to a person: no guest data.
model Requirement {
  id                String          @id
  organizationId    String
  orderId          String
  /// The line it applies to; null = the whole order.
  lineId            String?
  entityTypeId      String
  /// The list value counted, e.g. Gluten in the list Allergens.
  vocabularyValueId String
  /// How many, e.g. 3 guests.
  quantity          Int
  /// Values of the type's own fields, keyed by `FieldDefinition.key`.
  fields            Json            @default("{}")
  status            RecordStatus    @default(ACTIVE)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?
  order            Order          @relation(fields: [orderId, organizationId], references: [id, organizationId])
  line              Line?           @relation(fields: [lineId, organizationId], references: [id, organizationId])
  entityType        EntityType      @relation(fields: [entityTypeId, organizationId], references: [id, organizationId])
  vocabularyValue   VocabularyValue @relation(fields: [vocabularyValueId, organizationId], references: [id, organizationId])
  /// The supertable row this record extends (ADR 0056).
  record            Record          @relation(fields: [id, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@index([organizationId, orderId, status])
  @@index([organizationId, lineId])
  @@index([organizationId, vocabularyValueId])
  @@index([organizationId, entityTypeId])
}
