// Domain history (ADR 0054): append-only tables owned by core. The current status of a order and
// the current state of a line are projections of them: a trigger on insert sets `Order.statusId`
// and `Line.stateId` (`packages/db/sql/domain_history.sql`), and nothing else changes them.
// The audit log stays evidence; no feature reads history from it.

/// What made a order change status (ADR 0054).
enum StatusChangeTrigger {
  /// A person moved the order (`order.changeStatus`, `order.create`).
  MANUAL
  /// A quote event moved it (`QUOTE_SENT`, `QUOTE_ACCEPTED`).
  QUOTE_EVENT
  /// The order was created from a predefined order (`order.createFromTemplate`).
  TEMPLATE
  /// The system moved it, e.g. archiving the status it was in.
  SYSTEM
}

/// What made a line change state (ADR 0054).
enum StateChangeTrigger {
  /// A person set the state (`line.changeState`).
  MANUAL
  /// The order's status (status grid, closing release, `line.followStatus`).
  STATUS
  /// `order.expireHolds` moved an expired soft hold to its expiry state.
  EXPIRY
  /// The system, e.g. the first state of a new line or a line moved to an item of another type.
  SYSTEM
}

/// Order status change – one entry of a order's status history. Append-only. The newest row
/// (`seq`) is the order's current status: inserting a row sets `Order.statusId` by trigger, which
/// in turn re-derives the order's holds (ADR 0053) in the same transaction.
model OrderStatusChange {
  id             String              @id @default(cuid(2))
  organizationId String
  /// Insertion order; the newest row is the current status.
  seq            Int                 @default(autoincrement())
  orderId       String
  /// Null for the first row (the status the order was created in).
  fromStatusId   String?
  toStatusId     String
  /// Free text given with the move; required by `requiresReason` statuses.
  reason         String?
  trigger        StatusChangeTrigger
  changedAt      DateTime            @default(now())
  /// User who made the change; null for the system.
  changedBy      String?
  order         Order              @relation(fields: [orderId, organizationId], references: [id, organizationId])
  fromStatus     OrderStatus?       @relation("StatusChangeFrom", fields: [fromStatusId, organizationId], references: [id, organizationId])
  toStatus       OrderStatus        @relation("StatusChangeTo", fields: [toStatusId, organizationId], references: [id, organizationId])

  @@unique([seq])
  @@index([organizationId, orderId, seq])
  @@index([organizationId, toStatusId, changedAt])
}

/// Line state change – one entry of a line's state history. Append-only. The newest row (`seq`)
/// is the line's current state: inserting a row sets `Line.stateId` by trigger, which re-derives
/// the line's hold (ADR 0053) in the same transaction. `changedAt` of the newest row is "held since".
model LineStateChange {
  id             String             @id @default(cuid(2))
  organizationId String
  /// Insertion order; the newest row is the current state.
  seq            Int                @default(autoincrement())
  lineId         String
  /// Null for the first row of a line, or after a line without a state.
  fromStateId    String?
  /// Null when the line lost its item (a line without an item has no state).
  toStateId      String?
  trigger        StateChangeTrigger
  changedAt      DateTime           @default(now())
  /// User who made the change; null for the system.
  changedBy      String?
  line           Line               @relation(fields: [lineId, organizationId], references: [id, organizationId])
  fromState      ItemState?         @relation("StateChangeFrom", fields: [fromStateId, organizationId], references: [id, organizationId])
  toState        ItemState?         @relation("StateChangeTo", fields: [toStateId, organizationId], references: [id, organizationId])

  @@unique([seq])
  @@index([organizationId, lineId, seq])
  @@index([organizationId, toStateId, changedAt])
}

/// Order estimate – one entry of a order's value estimates, append-only (ADR 0074). The newest
/// row (`seq`) is the current estimate; there is no column on `Order`. The first row against the
/// accepted quote's total shows how far off the first estimate was.
model OrderEstimate {
  id             String   @id @default(cuid(2))
  organizationId String
  /// Insertion order; the newest row is the current estimate.
  seq            Int      @default(autoincrement())
  orderId       String
  /// Estimated value excl. VAT in minor units (1/100 kr); null clears the estimate.
  valueMinor     Int?
  changedAt      DateTime @default(now())
  /// User who made the change; null for the system.
  changedBy      String?
  order         Order   @relation(fields: [orderId, organizationId], references: [id, organizationId])

  @@unique([seq])
  @@index([organizationId, orderId, seq])
}
