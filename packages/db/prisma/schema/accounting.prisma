/// The organization's accounts that rows raised in the accounting system post to (ADR 0077, 0106):
/// the customer advances account and the default revenue account. One row per organization, created by
/// the first `accountingSettings.update`; until then reads return the BAS defaults below. Owned.
/// `status` is the soft-delete flag (ADR 0006); the row is never archived.
model AccountingSettings {
  id                   String       @id @default(cuid(2))
  organizationId       String       @unique
  /// Customer advances: paid deposits until invoiced.
  advancesAccount      String       @default("2420")
  /// Revenue when neither the item nor its type names an account (`RevenueAccount`).
  revenueAccount       String       @default("3001")
  status               RecordStatus @default(ACTIVE)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  createdBy            String?

  @@unique([id, organizationId])
}

/// RevenueAccount – the revenue account of one item type or one item (ADR 0077): exactly one of
/// `entityTypeId` and `itemId` (check constraint). An item's row wins over its type's, which wins
/// over `AccountingSettings.revenueAccount` (null = inherit, ADR 0051: no row, no copy). Owned by
/// the finance feature, replaced as a set by `accountingSettings.update` and audited there.
/// `isDefault` (owned, ADR 0109) marks the row whose account is the default revenue account; at
/// most one per organization (partial unique index `RevenueAccount_one_default` in the migration,
/// which Prisma cannot express).
model RevenueAccount {
  id             String      @id @default(cuid(2))
  organizationId String
  entityTypeId   String?
  itemId         String?
  account        String
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdBy      String?
  entityType     EntityType? @relation(fields: [entityTypeId, organizationId], references: [id, organizationId])
  item           Item?       @relation(fields: [itemId, organizationId], references: [id, organizationId])

  @@unique([organizationId, entityTypeId])
  @@unique([organizationId, itemId])
}
