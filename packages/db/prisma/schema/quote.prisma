/// Fixed status of a quote (ADR 0022). Changed only by the quote's own commands.
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

/// Quote – a versioned proposal to an inquiry (ADR 0022). `quoteStatus` follows a fixed state
/// machine (`DRAFT → SENT → ACCEPTED | DECLINED | EXPIRED`) and is never set by `quote.update`.
/// A new version copies the previous one (`previousId`); only a DRAFT can be edited. The totals
/// are the sum of the lines. It has no owner of its own: it uses the inquiry's (ADR 0034).
/// `status` is the soft-delete flag (ADR 0006).
model Quote {
  id                String       @id @default(cuid(2))
  organizationId    String
  inquiryId         String
  /// 1 for the first quote of the inquiry, then one higher per new version.
  version           Int
  /// The version this one was made from; the lines' change markers compare against it.
  previousId        String?
  quoteStatus       QuoteStatus  @default(DRAFT)
  validUntil        DateTime?
  terms             String?
  /// Sums of the lines in minor units (1/100 kr).
  totalExclVatMinor Int          @default(0)
  totalInclVatMinor Int          @default(0)
  statusChangedAt   DateTime     @default(now())
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  createdBy         String?
  inquiry           Inquiry      @relation(fields: [inquiryId, organizationId], references: [id, organizationId])
  previous          Quote?       @relation("QuoteVersions", fields: [previousId, organizationId], references: [id, organizationId])
  next              Quote[]      @relation("QuoteVersions")
  lines             OrderLine[]

  @@unique([id, organizationId])
  @@unique([inquiryId, version])
  @@index([organizationId, status, quoteStatus])
  @@index([organizationId, inquiryId])
}

/// Order line – what is charged (ADR 0021, 0022). A snapshot of the item's name, price, VAT and
/// inherited tags when the line was made; later changes to the item do not touch it. Replaced as a
/// set on a DRAFT quote and audited on the quote.
model OrderLine {
  id                String     @id @default(cuid(2))
  organizationId    String
  quoteId           String
  itemId            String
  /// Order on the quote, from 0.
  position          Int
  name              String
  quantity          Int
  /// Price per unit in minor units (1/100 kr), in the item's price unit.
  unitPriceMinor    Int
  priceUnit         PriceUnit?
  discountPercent   Int        @default(0)
  vatRatePercent    Int
  /// The list values the item contains (`item.resolve`): `[{ valueId, vocabularyId, name }]`.
  tags              Json       @default("[]")
  totalExclVatMinor Int
  vatMinor          Int
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  createdBy         String?
  quote             Quote      @relation(fields: [quoteId, organizationId], references: [id, organizationId])
  item              Item       @relation(fields: [itemId, organizationId], references: [id, organizationId])

  @@index([organizationId, quoteId])
  @@index([organizationId, itemId])
}
