/// Fixed status of a quote (ADR 0022). Changed only by the quote's own commands.
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

/// How the customer's acceptance was recorded (ADR 0022). Only staff entry exists so far.
enum AcceptanceMethod {
  MANUAL
}

/// Quote – a versioned proposal to a ticket (ADR 0022). `quoteStatus` follows a fixed state
/// machine (`DRAFT → SENT → ACCEPTED | DECLINED | EXPIRED`) and is never set by `quote.update`.
/// A DRAFT stores no lines: it is a live view of the ticket's priced lines (ADR 0052). `quote.send`
/// freezes them as `OrderLine` rows and stores the totals. A new version (`previousId`) is a new
/// DRAFT. It has no owner of its own: it uses the ticket's (ADR 0034).
/// `status` is the soft-delete flag (ADR 0006).
model Quote {
  id                String            @id @default(cuid(2))
  organizationId    String
  ticketId          String
  /// 1 for the first quote of the ticket, then one higher per new version.
  version           Int
  /// The version this one was made from; the lines' change markers compare against it.
  previousId        String?
  quoteStatus       QuoteStatus       @default(DRAFT)
  validUntil        DateTime?
  terms             String?
  /// Sums of the frozen lines in minor units (1/100 kr), set by `quote.send`; 0 on a DRAFT.
  /// An alternative group counts its chosen option, or its cheapest one until chosen (ADR 0052).
  totalExclVatMinor Int               @default(0)
  totalInclVatMinor Int               @default(0)
  statusChangedAt   DateTime          @default(now())
  /// Set by `quote.accept` only: the staff user who recorded the acceptance, when, and how.
  acceptedBy        String?
  acceptedAt        DateTime?
  acceptanceMethod  AcceptanceMethod?
  status            RecordStatus      @default(ACTIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         String?
  ticket            Ticket            @relation(fields: [ticketId, organizationId], references: [id, organizationId])
  previous          Quote?            @relation("QuoteVersions", fields: [previousId, organizationId], references: [id, organizationId])
  next              Quote[]           @relation("QuoteVersions")
  lines             OrderLine[]
  payments          Payment[]

  @@unique([id, organizationId])
  @@unique([ticketId, version])
  @@index([organizationId, status, quoteStatus])
  @@index([organizationId, ticketId])
}

/// Order line – a frozen snapshot of one priced ticket line (ADR 0052): its name, effective price,
/// VAT, the item's inherited tags and the totals when the quote was sent or the invoice created.
/// Belongs to exactly one quote or invoice (check constraint in the migration). Written only by
/// `quote.send` and `invoice.create` and never changed afterwards; audited on its owner.
model OrderLine {
  id                     String            @id @default(cuid(2))
  organizationId         String
  quoteId                String?
  invoiceId              String?
  /// The ticket line this snapshot was taken from; pairs versions' lines (ADR 0052).
  lineId                 String
  itemId                 String?
  /// Order on the quote, from 0.
  position               Int
  name                   String
  quantity               Int
  /// Price per unit in minor units (1/100 kr), in the item's price unit.
  unitPriceMinor         Int
  priceUnit              PriceUnit?
  discountPercent        Decimal           @default(0) @db.Decimal(5, 2)
  vatRatePercent         Int
  /// The list values the item contains (`item.resolve`): `[{ valueId, vocabularyId, name }]`.
  tags                   Json              @default("[]")
  totalExclVatMinor      Int
  /// VAT on the line total: the sum of `vatRows`.
  vatMinor               Int
  /// VAT per rate (ADR 0059): `[{ vatRatePercent, totalExclVatMinor, vatMinor }]`, one row for an
  /// ordinary line and one per rate of its parts for a bundle line (`allocateBundleVat`).
  vatRows                Json              @default("[]")
  /// Snapshot of the line's bundle line (ADR 0059); set on a part line, which never counts.
  parentLineId           String?
  /// Snapshot of the line's alternative group (ADR 0052): its id and name; null on an ordinary line.
  alternativeGroupId     String?
  alternativeGroupName   String?
  /// Snapshot: whether the group had a chosen option; null on an ordinary line. Any false makes
  /// the quote's totals "from" prices (derived, not stored).
  alternativeGroupChosen Boolean?
  /// Snapshot: whether the line counts in the quote's totals. False for the options of a group
  /// that are not its chosen one (or, until chosen, not its cheapest one).
  inTotal                Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  createdBy              String?
  quote                  Quote?            @relation(fields: [quoteId, organizationId], references: [id, organizationId])
  invoice                Invoice?          @relation(fields: [invoiceId, organizationId], references: [id, organizationId])
  line                   Line              @relation("OrderLineLine", fields: [lineId, organizationId], references: [id, organizationId])
  parentLine             Line?             @relation("OrderLineParent", fields: [parentLineId, organizationId], references: [id, organizationId])
  item                   Item?             @relation(fields: [itemId, organizationId], references: [id, organizationId])
  alternativeGroup       AlternativeGroup? @relation(fields: [alternativeGroupId, organizationId], references: [id, organizationId])

  @@index([organizationId, quoteId])
  @@index([organizationId, invoiceId])
  @@index([organizationId, alternativeGroupId])
  @@index([organizationId, lineId])
  @@index([organizationId, parentLineId])
  @@index([organizationId, itemId])
}
