/// Ticket – one customer request from first contact to the delivered event (ADR 0043). Its type
/// (base `TICKET`) decides its own fields. `statusId` is one of the organization's own statuses. It
/// is a projection of the status history (ADR 0054): the trigger on `TicketStatusChange` insert sets
/// it (`domain_history.sql`), and core never writes it after the insert. When the ticket entered
/// its status and why come from the newest `TicketStatusChange`.
/// `status` is the soft-delete flag (ADR 0006), not the status.
/// Trigger (ADR 0053): changing `statusId` or `status` re-derives the holds of the ticket's lines
/// (an archived ticket or one in a closing status holds nothing, `sync_line_occupancy.sql`).
model Ticket {
  id                  String               @id
  organizationId      String
  /// Reference number, sequential per organization (1, 2, 3, …).
  reference           Int
  entityTypeId        String
  customerId          String
  /// A contact person at the customer (optional).
  contactId           String?
  statusId            String
  /// The period the customer asked for; each line has its own time.
  desiredStartsAt     DateTime?
  desiredEndsAt       DateTime?
  /// The expected number of guests; lines with no quantity inherit it (ADR 0052).
  estimatedHeadcount  Int?
  /// Locked some days before the event; wins over the estimate when set.
  guaranteedHeadcount Int?
  /// Budget in minor units (1/100 kr).
  budgetMinor         Int?
  /// Lines in an `expires` state fall to their type's `expiryStateId` after this date (ADR 0044).
  holdsUntil          DateTime?
  /// Values of the type's own fields, keyed by `FieldDefinition.key`.
  fields              Json                 @default("{}")
  status              RecordStatus         @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  createdBy           String?
  entityType          EntityType           @relation(fields: [entityTypeId, organizationId], references: [id, organizationId])
  customer            Customer             @relation(fields: [customerId, organizationId], references: [id, organizationId])
  contact             Contact?             @relation(fields: [contactId, organizationId], references: [id, organizationId])
  ticketStatus        TicketStatus         @relation(fields: [statusId, organizationId], references: [id, organizationId])
  inboundEmails       InboundEmail[]
  payments            Payment[]
  deposits            Deposit[]
  invoices            Invoice[]
  lines               Line[]
  alternativeGroups   AlternativeGroup[]
  quotes              Quote[]
  statusChanges       TicketStatusChange[]
  requirements        Requirement[]
  sheets              Sheet[]
  /// The supertable row this record extends (ADR 0056).
  record              Record               @relation(fields: [id, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@unique([organizationId, reference])
  @@index([organizationId, status, desiredStartsAt])
  @@index([organizationId, customerId])
  @@index([organizationId, statusId])
  @@index([organizationId, holdsUntil])
}
