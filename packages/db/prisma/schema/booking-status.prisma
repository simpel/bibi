// Booking statuses per organization (ADR 0022): the organization's own labels, each inside a
// fixed phase that controls the system's behaviour. Transitions between them are data too.

/// The fixed phase of a booking status. The phase rules cannot be turned off.
enum BookingPhase {
  TENTATIVE
  CONFIRMED
  COMPLETED
  CANCELLED
}

/// Booking status – an organization's own status, e.g. Tentative or Final count locked.
/// The first active status (by `position`) of a phase is that phase's default.
model BookingStatus {
  id              String                    @id @default(cuid(2))
  organizationId  String
  name            String
  color           String
  phase           BookingPhase
  position        Int                       @default(0)
  status          RecordStatus              @default(ACTIVE)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  createdBy       String?
  transitionsFrom BookingStatusTransition[] @relation("TransitionFrom")
  transitionsTo   BookingStatusTransition[] @relation("TransitionTo")
  bookings        Booking[]

  @@unique([id, organizationId])
  @@index([organizationId, status, position])
}

/// Booking status transition – an allowed change from one status to another (from → to).
/// Replaced as a set per `from` status by `bookingStatus.setTransitions`.
model BookingStatusTransition {
  id             String        @id @default(cuid(2))
  organizationId String
  fromStatusId   String
  toStatusId     String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdBy      String?
  fromStatus     BookingStatus @relation("TransitionFrom", fields: [fromStatusId, organizationId], references: [id, organizationId])
  toStatus       BookingStatus @relation("TransitionTo", fields: [toStatusId, organizationId], references: [id, organizationId])

  @@unique([fromStatusId, toStatusId])
  @@index([organizationId, fromStatusId])
}
