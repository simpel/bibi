/// Search index row per entity (hybrid FTS + pgvector). Written via src/embeddings/* raw SQL.
/// `search` is a generated tsvector column (see migration); `embedding` is vector(1536).
model Embedding {
  id             String                       @id
  organizationId String
  /// The embeddable's type (`Embeddable.entityType`, e.g. `item`), also for records.
  entityType     String
  /// Id of a non-record entity (venue, skill, conversation); null for records.
  entityId       String?
  /// The record (ADR 0056) for record entities; null otherwise. Exactly one of the two is set.
  recordId       String?
  model          String
  content        String
  contentHash    String
  embedding      Unsupported("vector(1536)")?
  search         Unsupported("tsvector")?     @default(dbgenerated("to_tsvector('simple'::regconfig, content)"))
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  record         Record?                      @relation(fields: [recordId, organizationId], references: [id, organizationId])

  @@unique([organizationId, entityType, entityId])
  @@unique([organizationId, recordId])
  @@index([organizationId, entityType])
  @@index([search], type: Gin)
}
