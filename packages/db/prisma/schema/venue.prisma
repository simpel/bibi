/// Venue – a building or site. Bookable items may belong to a venue (ADR 0021).
model Venue {
  id                    String       @id @default(cuid(2))
  organizationId        String
  name                  String
  description           String?
  streetAddress         String?
  postalCode            String?
  city                  String?
  country               String       @default("SE")
  contactEmail          String?
  contactPhone          String?
  openingHours          String?
  defaultVatRatePercent Int          @default(25)
  status                RecordStatus @default(ACTIVE)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  createdBy             String?
  items                 Item[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
}
