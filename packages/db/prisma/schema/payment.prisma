/// A payment requested from the customer for a ticket (ADR 0028, 0029): a card checkout or a
/// Stripe invoice, charged directly on the organization's connected account (direct charge, the
/// venue is the merchant). Created by `payment.create`; the status follows the provider (webhook).
/// It settles exactly one receivable (ADR 0057): a sent quote, a deposit or an invoice (check
/// constraint in the migration). `status`, `paidAt` and `refundedMinor` mirror Stripe and are
/// written only by `payment.applySignal`; what a receivable or ticket has paid is derived from them.
/// Never deleted: `status` is its lifecycle.
model Payment {
  id                  String        @id @default(cuid(2))
  organizationId      String
  ticketId            String
  /// The receivable this payment settles: exactly one of these three is set.
  quoteId             String?
  depositId           String?
  invoiceId           String?
  method              PaymentMethod
  status              PaymentStatus @default(PENDING)
  /// Amount in minor units (öre for SEK).
  amountMinor         Int
  /// ISO 4217, upper case.
  currency            String        @default("SEK")
  /// Bibi's application fee on the charge in minor units; null = no fee.
  applicationFeeMinor Int?
  /// Connected account the charge was made on (`acct_...`).
  providerAccountId   String
  /// PSP reference: the Stripe Checkout Session (`cs_...`) or Invoice (`in_...`) id. Null until
  /// the provider call after the commit has succeeded (ADR 0058).
  providerReference   String?
  /// Where the customer pays: the hosted checkout page or the hosted invoice page.
  paymentUrl          String?
  /// Unguessable token in the public payment page URL `/pay/<token>` (ADR 0028). Never in the DTO.
  publicToken         String        @unique
  /// When the hosted checkout stops accepting payment; null for invoices.
  expiresAt           DateTime?
  /// Set when the provider reports the payment as completed.
  paidAt              DateTime?
  /// Refunded so far, in minor units.
  refundedMinor       Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  createdBy           String?
  ticket              Ticket        @relation(fields: [ticketId, organizationId], references: [id, organizationId])
  quote               Quote?        @relation(fields: [quoteId, organizationId], references: [id, organizationId])
  deposit             Deposit?      @relation(fields: [depositId, organizationId], references: [id, organizationId])
  invoice             Invoice?      @relation(fields: [invoiceId, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@unique([providerReference])
  @@index([organizationId, ticketId])
  @@index([organizationId, quoteId])
  @@index([organizationId, depositId])
  @@index([organizationId, invoiceId])
}

enum PaymentMethod {
  /// Card (and later Stripe's other wallet methods) through a hosted checkout.
  CARD
  /// A Stripe invoice sent to the customer, paid by bank transfer or card.
  INVOICE
}

enum PaymentStatus {
  /// Requested, not paid yet.
  PENDING
  /// Paid in full.
  SUCCEEDED
  /// The provider reported the payment as failed.
  FAILED
  /// The checkout expired or the invoice was voided before payment.
  CANCELLED
  /// Paid and then refunded in full.
  REFUNDED
}

/// A Stripe webhook event that has been handled (ADR 0028). The event id is the dedupe key: a
/// redelivered event finds its row and changes nothing. Platform table (an event is resolved to an
/// organization through its Payment or PaymentAccount), written only with `getDb()`.
model StripeWebhookEvent {
  id         String   @id @default(cuid(2))
  /// Stripe's event id (`evt_...`).
  eventId    String   @unique
  type       String
  receivedAt DateTime @default(now())
}
