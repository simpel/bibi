/// A payment requested from the customer for an order (ADR 0028, 0029, 0100): the request the
/// customer pays (amount, receivable, public token). Each try at a provider is a `PaymentAttempt`
/// with its own reference, link and expiry. It settles exactly one receivable (ADR 0057): a sent
/// quote, a deposit or an invoice (check constraint in the migration). Owned: amount, currency,
/// receivable, `method`, `provider` and `connectionId` (where it was requested, at create).
/// `status`, `paidAt` and `refundedMinor` mirror the provider and are written only by the signal
/// path (`payment.applySignal`, `invoice.sync`); what a receivable or order has paid is derived from
/// them. `refundedMinor` stays a mirror until Bibi starts refunds (phase 2 derives it from
/// `PaymentRefund`, ADR 0100). Never deleted: `status` is its lifecycle.
model Payment {
  id                  String                  @id @default(cuid(2))
  organizationId      String
  orderId            String
  /// The receivable this payment settles: exactly one of these three is set.
  quoteId             String?
  depositId           String?
  invoiceId           String?
  method              PaymentMethod
  status              PaymentStatus           @default(PENDING)
  /// Amount in minor units (öre for SEK).
  amountMinor         Int
  /// ISO 4217, upper case.
  currency            String                  @default("SEK")
  /// Bibi's application fee on the charge in minor units; null = no fee.
  applicationFeeMinor Int?
  /// Where the payment was made (ADR 0100): the provider Bibi asked, or the ledger provider that
  /// booked it on its invoice (Fortnox). Null for a payment no provider took (MANUAL).
  provider            Provider?
  /// The connection the payment was requested on; null when no connection was used.
  connectionId        String?
  /// Unguessable token in the public payment page URL `/pay/<token>` (ADR 0028). Never in the DTO.
  publicToken         String                  @unique
  /// Set when the provider reports the payment as completed.
  paidAt              DateTime?
  /// Refunded so far, in minor units (the provider's mirror; see the model comment).
  refundedMinor       Int                     @default(0)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  createdBy           String?
  order              Order                  @relation(fields: [orderId, organizationId], references: [id, organizationId])
  quote               Quote?                  @relation(fields: [quoteId, organizationId], references: [id, organizationId])
  deposit             Deposit?                @relation(fields: [depositId, organizationId], references: [id, organizationId])
  invoice             Invoice?                @relation(fields: [invoiceId, organizationId], references: [id, organizationId])
  connection          ProviderConnection?     @relation(fields: [connectionId, organizationId], references: [id, organizationId])
  attempts            PaymentAttempt[]
  refunds             PaymentRefund[]
  notifications       Notification[]
  exportEntries       AccountingExportEntry[]

  @@unique([id, organizationId])
  @@index([organizationId, orderId])
  @@index([organizationId, quoteId])
  @@index([organizationId, depositId])
  @@index([organizationId, invoiceId])
  @@index([organizationId, connectionId])
}

/// One try to collect a payment at a provider (ADR 0100): a hosted card checkout, a provider
/// invoice, later a Swish request. Owned: `paymentId`, `method`, `provider`, `connectionId`.
/// Mirrors from the provider: `providerReference` (null until the call after the commit stored it,
/// ADR 0058), `url`, `qrToken`, `expiresAt` and `status` (written by the signal path). The first
/// attempt that succeeds settles the payment. A payment Fortnox booked on its invoice is one
/// SUCCEEDED attempt keyed `fortnox:<organizationId>:<payment number>`.
model PaymentAttempt {
  id                String               @id @default(cuid(2))
  organizationId    String
  paymentId         String
  method            PaymentMethod
  provider          Provider
  connectionId      String?
  /// The provider's id: Stripe Checkout Session `cs_...` or Invoice `in_...`; unique per provider.
  providerReference String?
  /// Where the customer pays: the hosted checkout or invoice page.
  url               String?
  /// What a QR code encodes (Swish); null otherwise.
  qrToken           String?
  status            PaymentAttemptStatus @default(PENDING)
  /// When the provider stops accepting payment for it; null for invoices.
  expiresAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  createdBy         String?
  payment           Payment              @relation(fields: [paymentId, organizationId], references: [id, organizationId])
  connection        ProviderConnection?  @relation(fields: [connectionId, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@unique([provider, providerReference])
  @@index([organizationId, paymentId])
  @@index([organizationId, connectionId])
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  /// Card (and the operator's wallet methods) through a hosted checkout.
  CARD
  /// Swish (ADR 0100).
  SWISH
  /// Paid against an invoice the provider raised (a Stripe invoice, or booked on a Fortnox invoice).
  INVOICE
  /// Bank transfer or cash recorded by staff, no provider (ADR 0100).
  MANUAL
}

enum PaymentStatus {
  /// Requested, not paid yet.
  PENDING
  /// Paid in full.
  SUCCEEDED
  /// The provider reported the payment as failed.
  FAILED
  /// The checkout expired or the invoice was voided before payment.
  CANCELLED
  /// Paid and then refunded in full.
  REFUNDED
}

/// PaymentRefund – one refund of a payment (ADR 0077, 0100), one row per refund. Owned:
/// `amountMinor` (this refund), `reason`, `initiatedBy` (null when the provider reported it) and
/// `status`; mirror: `providerReference`. Today every row is written by the signal path when the
/// provider reports a higher refunded total (`refundedTotalMinor`, unique per payment, so a repeated
/// signal adds nothing) and is SUCCEEDED. `Payment.refundedMinor` equals the sum of SUCCEEDED rows
/// (reconciliation check `payment refunds`).
model PaymentRefund {
  id                 String                  @id @default(cuid(2))
  organizationId     String
  paymentId          String
  /// This refund in minor units.
  amountMinor        Int
  /// Refunded on the payment so far, this refund included.
  refundedTotalMinor Int
  /// When the provider reported the refund: the date of its reversal voucher.
  refundedAt         DateTime
  status             PaymentRefundStatus     @default(SUCCEEDED)
  /// The provider's refund id; null when only a refunded total was reported.
  providerReference  String?
  reason             String?
  /// The user who started the refund in Bibi; null when it came from the provider.
  initiatedBy        String?
  createdAt          DateTime                @default(now())
  payment            Payment                 @relation(fields: [paymentId, organizationId], references: [id, organizationId])
  exportEntries      AccountingExportEntry[]

  @@unique([id, organizationId])
  @@unique([paymentId, refundedTotalMinor])
  @@unique([paymentId, providerReference])
  @@index([organizationId, refundedAt])
}

enum PaymentRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}
