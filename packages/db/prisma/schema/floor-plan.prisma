/// How a floor element is drawn and seated (ADR 0099). Generic shapes, no furniture words:
/// `RECT` and `ROUND` are bodies with chairs around them, `SEAT_ROW` is a row of chairs and
/// `ZONE` is an outlined area (a dance floor, a no-go zone). `DOOR` and `WINDOW` are openings in a
/// wall (ADR 0102): always fixed, never seated, snapped onto the outline.
enum FloorShape {
  RECT
  ROUND
  SEAT_ROW
  ZONE
  DOOR
  WINDOW
}

/// Floor element kind – one entry of the organization's furniture library (ADR 0099), e.g.
/// "Round table Ø180" or "Door". All columns are owned. Seats: `RECT` uses the four sides in the
/// element's own frame (top, right, bottom, left); `ROUND` and `SEAT_ROW` use `seats` (around the
/// body, along the row). `fixed` kinds belong to a floor plan, never to a layout.
model FloorElementKind {
  id             String         @id @default(cuid(2))
  organizationId String
  name           String
  shape          FloorShape
  widthCm        Int
  depthCm        Int
  seats          Int            @default(0)
  seatsTop       Int            @default(0)
  seatsRight     Int            @default(0)
  seatsBottom    Int            @default(0)
  seatsLeft      Int            @default(0)
  fixed          Boolean        @default(false)
  /// A clear area in front of the element (its local bottom side), e.g. a door's swing.
  keepClearCm    Int?
  /// DOOR, WINDOW: how far it opens, 0–180 degrees (ADR 0102); null = it does not open.
  swingDeg       Int?
  status         RecordStatus   @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdBy      String?
  elements       FloorElement[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
}

/// Floor plan – the drawing of one item with `SETUPS` (ADR 0099): its size, outline and fixed
/// elements, shared by every layout of the item. All columns are owned; `version` counts saves
/// (optimistic concurrency).
model FloorPlan {
  id             String         @id @default(cuid(2))
  organizationId String
  itemId         String
  widthCm        Int
  depthCm        Int
  /// The walls as points in centimetres, clockwise (coordinates only, no references).
  outline        Json
  /// Minimum aisle between pieces; null = no aisle check.
  minAisleCm     Int?
  version        Int            @default(1)
  status         RecordStatus   @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdBy      String?
  item           Item           @relation(fields: [itemId, organizationId], references: [id, organizationId])
  elements       FloorElement[]

  @@unique([id, organizationId])
  @@unique([itemId, organizationId])
  @@index([organizationId, status])
}

/// Layout – one way of furnishing a room (ADR 0099, 0102, 0103): a name, what it suits, a capacity
/// and setup and teardown minutes, with an optional drawing. A room has several; order lines book
/// room + layout. All columns are owned: `capacity` null = its seats; `setupMinutes` and
/// `teardownMinutes` null = the item's, else its type's (ADR 0059 as amended by 0103); `name` is
/// always written (nullable only for expand/contract); `setupId` is no longer written and is
/// dropped in the next release. `version` counts saves.
/// Trigger (ADR 0053): changing `setupMinutes` or `teardownMinutes` re-derives the holds of the
/// lines that book it and have not ended (`sync_line_occupancy.sql`).
model SetupLayout {
  id              String         @id @default(cuid(2))
  organizationId  String
  itemId          String
  setupId         String?
  name            String?
  /// What the layout is suited for, e.g. "Dinner with speeches, dance floor at the back".
  description     String?
  capacity        Int?
  setupMinutes    Int?
  teardownMinutes Int?
  note            String?
  version        Int            @default(1)
  status         RecordStatus   @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdBy      String?
  item           Item           @relation(fields: [itemId, organizationId], references: [id, organizationId])
  setup          Setup?         @relation(fields: [setupId, organizationId], references: [id, organizationId])
  elements       FloorElement[]
  lines          Line[]
  templateLines  OrderTemplateLine[]

  @@unique([id, organizationId])
  @@index([organizationId, itemId])
}

/// Floor element – one piece placed in a floor plan (fixed) or in a setup layout (ADR 0099).
/// Replaced as a set by `floorPlan.save` and `setupLayout.save`, audited on its parent. Exactly
/// one parent (CHECK in the migration). Position is the centre in centimetres; size and seats are
/// owned overrides, null = the kind's.
model FloorElement {
  id             String           @id @default(cuid(2))
  organizationId String
  floorPlanId    String?
  setupLayoutId  String?
  kindId         String
  position       Int
  xCm            Int
  yCm            Int
  rotationDeg    Int              @default(0)
  widthCm        Int?
  depthCm        Int?
  seats          Int?
  seatsTop       Int?
  seatsRight     Int?
  seatsBottom    Int?
  seatsLeft      Int?
  /// DOOR, WINDOW: own opening angle; null = the kind's.
  swingDeg       Int?
  /// DOOR, WINDOW in a floor plan: an emergency exit whose no-block zone every layout keeps clear
  /// (ADR 0103, a hard limit).
  emergencyExit  Boolean          @default(false)
  label          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  createdBy      String?
  floorPlan      FloorPlan?       @relation(fields: [floorPlanId, organizationId], references: [id, organizationId])
  setupLayout    SetupLayout?     @relation(fields: [setupLayoutId, organizationId], references: [id, organizationId])
  kind           FloorElementKind @relation(fields: [kindId, organizationId], references: [id, organizationId])

  @@index([organizationId, floorPlanId])
  @@index([organizationId, setupLayoutId])
  @@index([organizationId, kindId])
}
