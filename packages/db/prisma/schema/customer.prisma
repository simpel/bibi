/// Whether a customer buys as a business or a private person (ADR 0106). It decides what an
/// order's money needs: a business always gets a full invoice, a private person pays up front.
enum BuyerKind {
  BUSINESS
  PRIVATE
}

/// Customer – the organization (company, agency, association, private person) that buys
/// (ADR 0022). Its type (base `CUSTOMER`) decides its own fields.
model Customer {
  id                   String       @id
  organizationId       String
  entityTypeId         String
  name                 String
  email                String?
  phone                String?
  /// Business or private (owned, ADR 0106); each order inherits it unless it sets its own.
  buyerKind            BuyerKind    @default(BUSINESS)
  /// The organisation number, e.g. 556677-8899 (owned, ADR 0106); null = not given. Sent to the
  /// ledger provider and required before a business customer is invoiced.
  organizationNumber   String?
  /// Invoice address.
  invoiceStreetAddress String?
  invoicePostalCode    String?
  invoiceCity          String?
  invoiceCountry       String       @default("SE")
  /// Days until an invoice is due; null = the organization's default.
  paymentTermsDays     Int?
  /// Credit limit in minor units (1/100 kr); null = no limit set.
  creditLimitMinor     Int?
  /// Values of the type's own fields, keyed by `FieldDefinition.key`.
  fields               Json         @default("{}")
  status               RecordStatus @default(ACTIVE)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  createdBy            String?
  entityType           EntityType   @relation(fields: [entityTypeId, organizationId], references: [id, organizationId])
  contacts             Contact[]
  orders              Order[]
  /// Customer-specific packages (`Item.customerId`, ADR 0021).
  items                Item[]
  /// Customer prices (ADR 0023).
  priceLists           PriceList[]
  /// The supertable row this record extends (ADR 0056).
  record               Record       @relation(fields: [id, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, entityTypeId])
}

/// Contact – a person at a customer: orderer, invoice recipient or organizer (ADR 0022). Its
/// type (base `CONTACT`) decides its own fields, e.g. the person's role at the customer.
model Contact {
  id             String       @id
  organizationId String
  entityTypeId   String
  customerId     String
  name           String
  email          String?
  phone          String?
  /// Values of the type's own fields, keyed by `FieldDefinition.key`.
  fields         Json         @default("{}")
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?
  entityType     EntityType   @relation(fields: [entityTypeId, organizationId], references: [id, organizationId])
  customer       Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId])
  orders        Order[]
  /// The supertable row this record extends (ADR 0056).
  record         Record       @relation(fields: [id, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, entityTypeId])
}
