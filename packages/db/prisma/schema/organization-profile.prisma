/// Where an organization is in its first setup (ADR 0061). `PENDING` from creation until an
/// admin activates or skips the setup in the welcome flow.
enum SetupStatus {
  PENDING
  COMPLETED
  SKIPPED
}

/// The organization's own facts (ADR 0061): setup status, legal and contact data and address.
/// One row per organization, created `PENDING` by `provisionOrganization`. Org-scoped.
model OrganizationProfile {
  id             String       @id @default(cuid(2))
  organizationId String       @unique
  setupStatus    SetupStatus  @default(PENDING)
  legalName      String?
  orgNumber      String?
  streetAddress  String?
  postalCode     String?
  city           String?
  country        String       @default("SE")
  website        String?
  contactEmail   String?
  contactPhone   String?
  /// Owned, IANA name (ADR 0064): the zone of ticket-level times and the default of every venue.
  /// Read only through core's `effectiveTimeZone`. The default backfills existing rows and keeps
  /// the previous release's inserts working (expand/contract, ADR 0013); core validates every write.
  timeZone       String       @default("Europe/Stockholm")
  /// Owned (ADR 0076): the email domain whose verified users join as members when they sign in.
  /// Lowercase; taken from the creator's email at creation, or from the admin who turns domain
  /// join on. Never typed in, so nobody can claim a domain they have no address at.
  emailDomain    String?
  /// Owned (ADR 0076): domain join on or off, set by an admin. On by default.
  domainJoin     Boolean      @default(true)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?

  @@index([emailDomain])
}

/// A user who has been a member of the organization (ADR 0076). Domain join never adds them
/// again, so someone removed or who left stays out until invited. Append-only and owned: written
/// when a user joins (Better Auth's member hooks, domain join) and by domain join when it finds an
/// existing member; existing members were backfilled.
model KnownMember {
  id             String   @id @default(cuid(2))
  organizationId String
  userId         String
  createdAt      DateTime @default(now())

  @@unique([organizationId, userId])
}
