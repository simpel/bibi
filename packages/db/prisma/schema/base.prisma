// Generator + datasource. Models live in sibling files (one concept per file).
// Better Auth tables are added later in their own file (auth.prisma).

generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  // pgvector is enabled by raw SQL in the initial migration.
}

/// Soft-delete status shared by all org-scoped business entities.
enum RecordStatus {
  ACTIVE
  ARCHIVED
}
