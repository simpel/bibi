/// Responsibility (ADR 0034) – what someone answers for, e.g. Head of kitchen or Head of exhibits.
/// It covers item types and names a default assignee and default followers. The referenced ids
/// are validated by core (`responsibility.*`): item types are active types of base ITEM, people
/// are members of the organization (user ids). It carries no permissions.
model Responsibility {
  id                 String       @id @default(cuid(2))
  organizationId     String
  name               String
  /// Item types (`EntityType` of base ITEM) this responsibility covers.
  entityTypeIds      String[]
  /// The member (user id) who answers for it by default.
  defaultAssigneeId  String
  /// Members (user ids) who follow it by default.
  defaultFollowerIds String[]
  status             RecordStatus @default(ACTIVE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  createdBy          String?

  @@unique([id, organizationId])
  @@index([organizationId, status])
}
