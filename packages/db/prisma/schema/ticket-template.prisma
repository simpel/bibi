/// Ticket template – an organization's predefined ticket (ADR 0043): a ticket type, the status the
/// ticket starts in, default own-field values and lines. `ticket.createFromTemplate` makes a
/// ticket from it in one step. `status` is the soft-delete flag (ADR 0006).
model TicketTemplate {
  id             String               @id
  organizationId String
  name           String
  entityTypeId   String
  /// The status created tickets start in (not closing).
  statusId       String
  /// Default values of the ticket type's own fields, keyed by `FieldDefinition.key`.
  fields         Json                 @default("{}")
  status         RecordStatus         @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  createdBy      String?
  entityType     EntityType           @relation(fields: [entityTypeId, organizationId], references: [id, organizationId])
  ticketStatus   TicketStatus         @relation(fields: [statusId, organizationId], references: [id, organizationId])
  lines          TicketTemplateLine[]
  /// The supertable row this record extends (ADR 0056).
  record         Record               @relation(fields: [id, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, statusId])
}

/// Ticket template line – a line the ticket gets, timed from the ticket's start.
/// Replaced as a set by `ticketTemplate.update`.
model TicketTemplateLine {
  id              String         @id @default(cuid(2))
  organizationId  String
  templateId      String
  position        Int            @default(0)
  /// The line type (base `LINE`) of the created line.
  entityTypeId    String
  name            String
  itemId          String?
  setupId         String?
  /// Minutes from the ticket's start to the line's start.
  offsetMinutes   Int
  durationMinutes Int
  /// The line's quantity; null = the ticket's headcount (ADR 0052).
  quantity        Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdBy       String?
  template        TicketTemplate @relation(fields: [templateId, organizationId], references: [id, organizationId])
  entityType      EntityType     @relation(fields: [entityTypeId, organizationId], references: [id, organizationId])
  item            Item?          @relation(fields: [itemId, organizationId], references: [id, organizationId])
  setup           Setup?         @relation(fields: [setupId, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@index([organizationId, templateId, position])
  @@index([organizationId, itemId])
}
