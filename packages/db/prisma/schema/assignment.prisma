/// Assignment (ADR 0034) – who answers for a subject (a ticket or an item). A subject
/// has one main assignment (`responsibilityId` null) and, for tickets, one per responsibility.
/// `recordId` is the subject's `Record` (ADR 0056): the composite foreign key keeps it in the
/// organization; core checks that its base is a ticket or an item. `assigneeId` is a member (user id); it is null
/// when the subject only has followers so far.
model Assignment {
  id               String               @id @default(cuid(2))
  organizationId   String
  recordId         String
  responsibilityId String?
  assigneeId       String?
  status           RecordStatus         @default(ACTIVE)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  createdBy        String?
  record           Record               @relation(fields: [recordId, organizationId], references: [id, organizationId])
  responsibility   Responsibility?      @relation(fields: [responsibilityId, organizationId], references: [id, organizationId])
  followers        AssignmentFollower[]

  @@unique([id, organizationId])
  // The main assignment (no responsibility) is kept unique by a partial index in the migration.
  @@unique([organizationId, recordId, responsibilityId])
  @@index([organizationId, assigneeId, status])
}

/// What an explicit follower row says (ADR 0055): `FOLLOW` adds the member to the followers,
/// `UNFOLLOW` removes a member who follows by default (the responsibility's default followers).
enum FollowEffect {
  FOLLOW
  UNFOLLOW
}

/// A member (user id) who chose to follow or to leave an assignment (ADR 0034, 0055): need to know,
/// never required by rules. Only explicit choices are stored; the defaults come from the
/// responsibility. Removed when the choice is undone (audited on the assignment).
model AssignmentFollower {
  id             String       @id @default(cuid(2))
  organizationId String
  assignmentId   String
  userId         String
  effect         FollowEffect @default(FOLLOW)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?
  assignment     Assignment   @relation(fields: [assignmentId, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@unique([assignmentId, userId])
  @@index([organizationId, userId])
}
