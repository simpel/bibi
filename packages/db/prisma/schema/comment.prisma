/// Comment – staff's text on an order, or on one of its lines (ADR 0115). Read oldest first.
/// Every column is owned: the author writes `body`; `createdBy` is the author (set by `scopedDb`);
/// `editedAt` is set when the author changes the body. Archiving is the delete (ADR 0006).
/// Run sheets snapshot the comments of the rows they show (`RunSheet.content`).
model Comment {
  id              String           @id @default(cuid(2))
  organizationId  String
  orderId         String
  /// The line it is about; null = the whole order. A reply has its parent's.
  lineId          String?
  /// The comment this one answers (ADR 0115, owned, set once); null for a comment of its own.
  /// One level: a reply's parent is never a reply itself (core).
  parentCommentId String?
  /// The text, 1–2000 characters, line breaks kept.
  body            String
  /// When the author last changed the body; null = never edited.
  editedAt        DateTime?
  status          RecordStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       String?
  order           Order            @relation(fields: [orderId, organizationId], references: [id, organizationId])
  line            Line?            @relation(fields: [lineId, organizationId], references: [id, organizationId])
  parent          Comment?         @relation("CommentReplies", fields: [parentCommentId, organizationId], references: [id, organizationId])
  replies         Comment[]        @relation("CommentReplies")
  mentions        CommentMention[]

  @@unique([id, organizationId])
  @@index([organizationId, orderId, status])
  @@index([organizationId, lineId])
  @@index([organizationId, parentCommentId])
}

/// A colleague mentioned with @ in a comment (ADR 0115): a member's user id, never parsed from
/// the text. Owned by the comment's author; replaced as a set when the comment is edited.
model CommentMention {
  id             String   @id @default(cuid(2))
  organizationId String
  commentId      String
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  comment        Comment  @relation(fields: [commentId, organizationId], references: [id, organizationId])

  @@unique([commentId, userId])
  @@index([organizationId, userId])
}
