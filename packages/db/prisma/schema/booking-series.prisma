/// BookingSeries – a recurring booking (ADR 0023). `rule` is the structured RRULE subset
/// (`RecurrenceRule`), `template` what every occurrence gets (`BookingSeriesTemplate`: bookable
/// items, setup, headcount, owners and own fields). Each occurrence is an ordinary `Booking` with
/// `seriesId` and `occurrenceIndex`, created with the series at most 12 months or 52 ahead.
/// `startsAt`, `durationMinutes` and `template` describe the series going forward: a "this and
/// following" change (`bookingSeries.updateOccurrences`) updates them, and its time offset moves
/// `startsAt` too.
model BookingSeries {
  id                 String       @id @default(cuid(2))
  organizationId     String
  /// The booking type every occurrence gets (base `BOOKING`).
  entityTypeId       String
  customerId         String
  rule               Json
  /// The rule's anchor (start of the first occurrence); occurrences keep its wall time in `timeZone`.
  startsAt           DateTime
  durationMinutes    Int
  timeZone           String
  template           Json         @default("{}")
  /// True when the rule continues past the generated horizon (12 months / 52 occurrences).
  truncated          Boolean      @default(false)
  /// Set by `bookingSeries.cancel`: its upcoming occurrences were cancelled, past ones kept.
  cancelledAt        DateTime?
  cancellationReason String?
  status             RecordStatus @default(ACTIVE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  createdBy          String?
  entityType         EntityType   @relation(fields: [entityTypeId, organizationId], references: [id, organizationId])
  customer           Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId])
  bookings           Booking[]

  @@unique([id, organizationId])
  @@index([organizationId, status, startsAt])
  @@index([organizationId, customerId])
}
