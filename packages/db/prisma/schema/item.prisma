/// How a `PRICED` item's price is applied.
enum PriceUnit {
  PER_PERSON
  PER_UNIT
  PER_HOUR
  FLAT
}

/// Artikel – anything that can be sold or booked (ADR 0021). Its type decides the capabilities;
/// the capability columns are null unless the type has the capability.
/// Trigger (ADR 0053, 0059): changing `setupMinutes` or `teardownMinutes` re-derives the holds of
/// the item's lines that have not ended (`sync_line_occupancy.sql`).
model Item {
  id                     String                    @id
  organizationId         String
  entityTypeId           String
  venueId                String?
  /// null = a catalog item; set = a customer-specific bundle, listed only with its customer.
  customerId             String?
  name                   String
  description            String?
  /// Values of the type's own fields, keyed by `FieldDefinition.key`.
  fields                 Json                      @default("{}")
  /// PRICED: price in minor units (1/100 kr), unit and VAT (null = the venue's default).
  priceMinor             Int?
  priceUnit              PriceUnit?
  vatRatePercent         Int?
  /// BOOKABLE: default length of a booking.
  defaultDurationMinutes Int?
  /// Buffers before and after a booking, in minutes (ADR 0059, owned); null = the type's.
  setupMinutes           Int?
  teardownMinutes        Int?
  status                 RecordStatus              @default(ACTIVE)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  createdBy              String?
  entityType             EntityType                @relation(fields: [entityTypeId, organizationId], references: [id, organizationId])
  venue                  Venue?                    @relation(fields: [venueId, organizationId], references: [id, organizationId])
  customer               Customer?                 @relation(fields: [customerId, organizationId], references: [id, organizationId])
  setups                 ItemSetup[]
  /// BUNDLE: the parts this item contains.
  parts                  ItemPart[]                @relation("ItemPartParent")
  /// The bundles this item is a part of.
  partOf                 ItemPart[]                @relation("ItemPartOf")
  /// CUSTOMISATIONS: the item's customisation groups (ADR 0059: on any item, not only bundles).
  customisationGroups    ItemCustomisationGroup[]
  /// The customisation groups this item is an option in.
  optionIn               ItemCustomisationOption[]
  /// BOOKABLE: the periods the item is held (ADR 0022).
  occupancies            Occupancy[]
  /// BOOKABLE: the lines held in this item.
  lines                  Line[]
  /// Lines of predefined tickets that use this item.
  templateLines          TicketTemplateLine[]
  /// Agreed prices on price lists (ADR 0023).
  priceListItems         PriceListItem[]
  /// Order lines that copied this item (snapshot).
  orderLines             OrderLine[]
  /// The supertable row this record extends (ADR 0056).
  record                 Record                    @relation(fields: [id, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, entityTypeId])
  @@index([organizationId, venueId])
  @@index([organizationId, customerId])
}

/// Item setup – capacity of a `SETUPS` item in one setup. Replaced as a set by `item.*`.
model ItemSetup {
  id             String   @id @default(cuid(2))
  organizationId String
  itemId         String
  setupId        String
  capacity       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  item           Item     @relation(fields: [itemId, organizationId], references: [id, organizationId])
  setup          Setup    @relation(fields: [setupId, organizationId], references: [id, organizationId])

  @@unique([itemId, setupId])
  @@index([organizationId, itemId])
}

/// Item part – one part of a `BUNDLE` item (ADR 0021). Replaced as a set by `item.*`.
/// The graph is acyclic and at most 5 levels deep; core enforces both.
model ItemPart {
  id              String   @id @default(cuid(2))
  organizationId  String
  parentId        String
  partId          String
  quantity        Int      @default(1)
  /// Start of the part relative to the start of the parent, in minutes.
  offsetMinutes   Int      @default(0)
  /// Length of the part; null = until the end of the parent. Both are defaults: a part line
  /// gets its times from them when the bundle is expanded and keeps its own after (ADR 0059).
  durationMinutes Int?
  /// Mandatory part (true) or optional part (false).
  required        Boolean  @default(true)
  /// Order of the parts on the item, from 0. Breaks ties between parts with the same offset.
  position        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  parent          Item     @relation("ItemPartParent", fields: [parentId, organizationId], references: [id, organizationId])
  part            Item     @relation("ItemPartOf", fields: [partId, organizationId], references: [id, organizationId])

  @@unique([parentId, partId])
  @@index([organizationId, parentId])
  @@index([organizationId, partId])
}

/// Item customisation group – pick between `minPick` and `maxPick` of its options (CUSTOMISATIONS,
/// ADR 0021, 0059). Hangs on any item of a type with CUSTOMISATIONS. Replaced as a set by `item.*`;
/// core enforces `0 <= minPick <= maxPick <= number of options`.
model ItemCustomisationGroup {
  id             String                    @id @default(cuid(2))
  organizationId String
  itemId         String
  name           String
  minPick        Int
  maxPick        Int
  /// Order of the groups on the item, from 0.
  position       Int
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  createdBy      String?
  item           Item                      @relation(fields: [itemId, organizationId], references: [id, organizationId])
  options        ItemCustomisationOption[]

  @@unique([id, organizationId])
  @@unique([itemId, name])
  @@index([organizationId, itemId])
}

/// What choosing a customisation option does to the price of the item it is chosen on (ADR 0059).
enum PriceEffect {
  /// Included in the item's price: the option line does not count in the totals.
  INCLUDED
  /// Charged on top: the option line counts at its own effective price.
  EXTRA
  /// Replaces the item's price: the option line counts and the item's line does not.
  REPLACES
}

/// Item customisation option – one item that can be chosen in a customisation group, with its
/// price effect (ADR 0059, owned). Replaced as a set with the groups by `item.*`. An item is an
/// option in at most one group of the same item; core enforces it.
model ItemCustomisationOption {
  id             String                 @id @default(cuid(2))
  organizationId String
  groupId        String
  /// The item that is chosen (another item, never the group's own item).
  itemId         String
  priceEffect    PriceEffect
  /// Order of the options in the group, from 0.
  position       Int
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  createdBy      String?
  group          ItemCustomisationGroup @relation(fields: [groupId, organizationId], references: [id, organizationId], onDelete: Cascade)
  item           Item                   @relation(fields: [itemId, organizationId], references: [id, organizationId])

  @@unique([groupId, itemId])
  @@index([organizationId, groupId])
  @@index([organizationId, itemId])
}
