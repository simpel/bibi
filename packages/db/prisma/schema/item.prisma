/// How a `PRICED` item's price is applied.
enum PriceUnit {
  PER_PERSON
  PER_UNIT
  PER_HOUR
  FLAT
}

/// Artikel – anything that can be sold or booked (ADR 0021). Its type decides the behaviours;
/// the behaviour columns are null unless the type has the behaviour.
model Item {
  id                     String               @id
  organizationId         String
  entityTypeId           String
  venueId                String?
  /// null = a catalog item; set = a customer-specific package, listed only with its customer.
  customerId             String?
  name                   String
  description            String?
  /// Values of the type's own fields, keyed by `FieldDefinition.key`.
  fields                 Json                 @default("{}")
  /// PRICED: price in minor units (1/100 kr), unit and VAT (null = the venue's default).
  priceMinor             Int?
  priceUnit              PriceUnit?
  vatRatePercent         Int?
  /// BOOKABLE: default length of a booking.
  defaultDurationMinutes Int?
  status                 RecordStatus         @default(ACTIVE)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  createdBy              String?
  entityType             EntityType           @relation(fields: [entityTypeId, organizationId], references: [id, organizationId])
  venue                  Venue?               @relation(fields: [venueId, organizationId], references: [id, organizationId])
  customer               Customer?            @relation(fields: [customerId, organizationId], references: [id, organizationId])
  setups                 ItemSetup[]
  /// COMPOSABLE: the parts this item contains.
  components             ItemComponent[]      @relation("ItemComponentParent")
  /// The composed items this item is a part of.
  partOf                 ItemComponent[]      @relation("ItemComponentPart")
  /// CHOICES: choice groups among the parts.
  choiceGroups           ItemChoiceGroup[]
  /// BOOKABLE: the periods the item is held (ADR 0022).
  occupancies            Occupancy[]
  /// BOOKABLE: the lines held in this item.
  lines                  Line[]
  /// Lines of predefined tickets that use this item.
  templateLines          TicketTemplateLine[]
  /// Agreed prices on price lists (ADR 0023).
  priceListItems         PriceListItem[]
  /// Order lines that copied this item (snapshot).
  orderLines             OrderLine[]
  /// The supertable row this record extends (ADR 0056).
  record                 Record               @relation(fields: [id, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, entityTypeId])
  @@index([organizationId, venueId])
  @@index([organizationId, customerId])
}

/// Item setup – capacity of a `SETUPS` item in one setup. Replaced as a set by `item.*`.
model ItemSetup {
  id             String   @id @default(cuid(2))
  organizationId String
  itemId         String
  setupId        String
  capacity       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  item           Item     @relation(fields: [itemId, organizationId], references: [id, organizationId])
  setup          Setup    @relation(fields: [setupId, organizationId], references: [id, organizationId])

  @@unique([itemId, setupId])
  @@index([organizationId, itemId])
}

/// Item component – one part of a `COMPOSABLE` item (ADR 0021). Replaced as a set by `item.*`.
/// The graph is acyclic and at most 5 levels deep; core enforces both.
model ItemComponent {
  id              String           @id @default(cuid(2))
  organizationId  String
  parentId        String
  partId          String
  quantity        Int              @default(1)
  /// Start of the part relative to the start of the parent, in minutes.
  offsetMinutes   Int              @default(0)
  /// Length of the part; null = the parent's length.
  durationMinutes Int?
  /// Mandatory part (true) or optional part (false).
  required        Boolean          @default(true)
  /// CHOICES: the choice group this part is an option in; null = not an option.
  choiceGroupId   String?
  /// Order of the parts on the item, from 0. Breaks ties between parts with the same offset.
  position        Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       String?
  parent          Item             @relation("ItemComponentParent", fields: [parentId, organizationId], references: [id, organizationId])
  part            Item             @relation("ItemComponentPart", fields: [partId, organizationId], references: [id, organizationId])
  choiceGroup     ItemChoiceGroup? @relation(fields: [choiceGroupId, organizationId], references: [id, organizationId])

  @@unique([parentId, partId])
  @@index([organizationId, parentId])
  @@index([organizationId, partId])
  @@index([organizationId, choiceGroupId])
}

/// Item choice group – pick between `minPick` and `maxPick` of the parts linked to it (CHOICES,
/// ADR 0021). Replaced as a set by `item.*` together with the parts; core enforces
/// `0 <= minPick <= maxPick <= number of options`.
model ItemChoiceGroup {
  id             String          @id @default(cuid(2))
  organizationId String
  itemId         String
  name           String
  minPick        Int
  maxPick        Int
  /// Order of the groups on the item, from 0.
  position       Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdBy      String?
  item           Item            @relation(fields: [itemId, organizationId], references: [id, organizationId])
  options        ItemComponent[]

  @@unique([id, organizationId])
  @@unique([itemId, name])
  @@index([organizationId, itemId])
}
