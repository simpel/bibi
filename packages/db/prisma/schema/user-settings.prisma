/// Where a user is in the first setup of an organization (ADR 0046): `PENDING` until they finish
/// or skip it. No row means they were never asked, so nothing is pending.
enum OnboardingStatus {
  PENDING
  COMPLETED
  SKIPPED
}

/// One typed settings row per user (ADR 0046), separate from the key/value `UserPreference`.
/// User-scoped, NOT org-scoped: it follows the user across organizations. Reached only through
/// `scopedDb`, which pins every query to the acting user (`USER_SCOPED_MODELS`). Upserted in
/// place; there is no soft delete and no `createdBy` (the owner is `userId`).
model UserSettings {
  id               String           @id @default(cuid(2))
  userId           String           @unique
  onboardingStatus OnboardingStatus
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}
