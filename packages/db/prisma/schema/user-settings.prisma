/// How a user wants dates written (ADR 0046 addendum 2026-10-25). Each value is a pattern:
/// D = day, MMM/MMMM = short/long month name in the UI language, MM = month number, YYYY = year.
enum DateFormat {
  D_MMM_YYYY
  D_MMMM_YYYY
  YYYY_MM_DD
  DD_MM_YYYY
  MM_DD_YYYY
  D_M_YYYY
}

/// 24 hour (`14:30`) or 12 hour (`2:30 PM`) clock.
enum ClockFormat {
  H24
  H12
}

/// How a user wants numbers written (#482): digit-group and decimal separators.
/// SPACE_COMMA = 1 234,50, COMMA_DOT = 1,234.50, DOT_COMMA = 1.234,50, SPACE_DOT = 1 234.50.
enum NumberFormat {
  SPACE_COMMA
  COMMA_DOT
  DOT_COMMA
  SPACE_DOT
}

/// Replaced by `MoneyFormat`; kept for the previous release until the contract step (ADR 0013).
enum CurrencyDisplay {
  SYMBOL
  CODE
}

/// How amounts are written, apart from `NumberFormat`; the name reads in screen order:
/// `CODE_COMMA` SEK 1,234.50, `COMMA_SYMBOL` 1,234.50 kr, `SPACE_SYMBOL` 1 234,50 kr,
/// `SPACE_CODE` 1 234,50 SEK.
enum MoneyFormat {
  CODE_COMMA
  COMMA_SYMBOL
  SPACE_SYMBOL
  SPACE_CODE
}

/// One typed settings row per user (ADR 0046), separate from the key/value `UserPreference`.
/// User-scoped, NOT org-scoped: it follows the user across organizations. Reached only through
/// `scopedDb`, which pins every query to the acting user (`USER_SCOPED_MODELS`). Upserted in
/// place; there is no soft delete and no `createdBy` (the owner is `userId`).
/// Owned: `dateFormat`, `clockFormat`, `numberFormat`, `moneyFormat`; `null` = the default
/// (`D_MMM_YYYY`, `H24`, the UI language's number style and `SPACE_SYMBOL`; ADR 0051).
/// `currencyDisplay` is legacy: written alongside `moneyFormat`, read by nothing; dropped later.
model UserSettings {
  id              String           @id @default(cuid(2))
  userId          String           @unique
  dateFormat      DateFormat?
  clockFormat     ClockFormat?
  numberFormat    NumberFormat?
  currencyDisplay CurrencyDisplay?
  moneyFormat     MoneyFormat?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}
