/// Marks an OAuth grant (user + client in one organization) as revoked by core
/// `oauthGrant.revoke` (ADR 0005). Access tokens are stateless JWTs, so `packages/auth` rejects
/// every token for this user, client and organization issued at or before `revokedAt`.
/// A later consent issues newer tokens, which are accepted again.
model OauthGrantRevocation {
  id             String   @id @default(cuid(2))
  organizationId String
  userId         String
  clientId       String
  revokedAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?

  @@unique([organizationId, userId, clientId])
}

/// An organization's connection to an outside system (ADR 0087), one row per provider. Owned:
/// `status`, the sealed tokens and their expiries (written at connect, refresh and disconnect, the
/// tokens only by `getFortnoxAccessToken` after connect), and the pending OAuth state
/// (`oauthStateHash`, `codeVerifierSealed`, `oauthStartedAt`, cleared on completion). Snapshots
/// from the provider at connect: `externalCompanyName`, `externalOrgNumber`, `externalTenantId`.
/// `refreshClaimedAt` is a 30-second lease: one caller at a time spends the rotating refresh token.
/// Tokens are AES-256-GCM sealed with `INTEGRATION_SECRET_KEY` and never leave core.
model IntegrationConnection {
  id                  String                      @id @default(cuid(2))
  organizationId      String
  provider            IntegrationProvider
  status              IntegrationConnectionStatus @default(PENDING)
  scope               String?
  accessTokenSealed   String?
  refreshTokenSealed  String?
  accessExpiresAt     DateTime?
  refreshExpiresAt    DateTime?
  refreshClaimedAt    DateTime?
  oauthStateHash      String?
  codeVerifierSealed  String?
  oauthStartedAt      DateTime?
  externalCompanyName String?
  externalOrgNumber   String?
  externalTenantId    String?
  connectedAt         DateTime?
  connectedBy         String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  createdBy           String?

  /// Fortnox's tenant id for this company in the Topics stream (ADR 0090), learned when the
  /// worker adds the connection; maps a stream event back to the organization.
  fortnoxTenantId    Int?
  @@unique([id, organizationId])
  @@unique([organizationId, provider])
  @@index([provider, status, refreshExpiresAt])
}

enum IntegrationProvider {
  FORTNOX
}

enum IntegrationConnectionStatus {
  /// Authorization started; waiting for the provider's callback.
  PENDING
  /// Tokens stored; the provider can be called.
  CONNECTED
  /// The provider refused the refresh token; an admin must reconnect.
  EXPIRED
  /// An admin disconnected; tokens cleared and revoked.
  DISCONNECTED
}

/// Where the worker's Fortnox Topics stream stopped, per topic (ADR 0090). Platform table, one
/// row per topic, written only by the worker with `getDb()`. Fortnox replays up to 14 days.
model FortnoxTopicOffset {
  topic     String   @id
  offset    String
  updatedAt DateTime @updatedAt
}
