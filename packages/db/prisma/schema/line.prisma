/// Line – a row in a ticket's run schedule (ADR 0022), e.g. a meeting, a break or lunch.
/// Its type (base `LINE`) decides its own fields. A line with an item has a state of the
/// item's type (ADR 0044). With a bookable item in a `SOFT` or `HARD` state it holds a `HOLD`
/// occupancy for `[startsAt, endsAt)` of the state's kind, plus a `SETUP` buffer right before
/// and a `TEARDOWN` buffer right after when its effective minutes are above zero (ADR 0059: setup
/// is the larger of the inherited `setupMinutes` and the setup's changeover time). All have
/// `lineId` set and follow the row. A database trigger writes them (ADR 0053,
/// `packages/db/sql/sync_line_occupancy.sql`) on insert and on every change of item, setup,
/// buffer minutes, time, state, ticket or status; application code never does. An untimed line
/// (no `startsAt`/`endsAt`, e.g. a fee) never holds and is not drawn on the calendar (ADR 0052).
/// The price columns are overrides: null = inherit (price list, then item; VAT: item, then venue).
/// `alternativeGroupId` (owned) makes the line one option of an `AlternativeGroup` (ADR 0052).
model Line {
  id                 String             @id
  organizationId     String
  ticketId           String
  entityTypeId       String
  name               String
  /// Both set or both null (untimed).
  startsAt           DateTime?
  endsAt             DateTime?
  /// The bookable item (`BOOKABLE`) the line is held in, if any.
  itemId             String?
  /// How the item is set up; one of the item's setups. Requires `itemId`.
  setupId            String?
  /// Buffers before and after, in minutes (ADR 0059, owned); null = the item's, else its type's.
  setupMinutes       Int?
  teardownMinutes    Int?
  /// How many; null = the ticket's headcount (guaranteed if set, else estimated).
  quantity           Int?
  /// Override of the unit price in minor units (1/100 kr); null = inherit.
  unitPriceMinor     Int?
  /// Override of the discount in percent, e.g. 10.00; null = inherit.
  discountPercent    Decimal?           @db.Decimal(5, 2)
  /// Override of the VAT rate in percent; null = inherit.
  vatRatePercent     Int?
  /// The alternative group this line is an option of; null for an ordinary line (ADR 0052).
  alternativeGroupId String?
  /// The bundle line this part line belongs to (ADR 0059, owned): set only when a bundle is
  /// expanded (`line.expandBundle`), never changed. A part line does not count in the totals.
  parentLineId       String?
  /// Internal note.
  note               String?
  /// Values of the type's own fields, keyed by `FieldDefinition.key`.
  fields             Json               @default("{}")
  /// The line's state, one of its item type's states; null for a line without an item. A
  /// projection of the state history (ADR 0054): set by the trigger on `LineStateChange` insert
  /// (`domain_history.sql`), never written after the insert. "Held since" is the newest change.
  stateId            String?
  /// Set by `line.changeState`: phase moves skip the line (ADR 0044).
  stateOverridden    Boolean            @default(false)
  status             RecordStatus       @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  createdBy          String?
  ticket             Ticket             @relation(fields: [ticketId, organizationId], references: [id, organizationId])
  entityType         EntityType         @relation(fields: [entityTypeId, organizationId], references: [id, organizationId])
  item               Item?              @relation(fields: [itemId, organizationId], references: [id, organizationId])
  setup              Setup?             @relation(fields: [setupId, organizationId], references: [id, organizationId])
  state              ItemState?         @relation(fields: [stateId, organizationId], references: [id, organizationId])
  requirements       Requirement[]
  occupancies        Occupancy[]
  orderLines         OrderLine[]        @relation("OrderLineLine")
  alternativeGroup   AlternativeGroup?  @relation("AlternativeGroupOptions", fields: [alternativeGroupId, organizationId], references: [id, organizationId])
  chosenIn           AlternativeGroup[] @relation("AlternativeGroupChoice")
  parentLine         Line?              @relation("LineParts", fields: [parentLineId, organizationId], references: [id, organizationId])
  partLines          Line[]             @relation("LineParts")
  /// Order lines whose bundle line this is (snapshot of `parentLineId`).
  partOrderLines     OrderLine[]        @relation("OrderLineParent")
  stateChanges       LineStateChange[]
  /// The supertable row this record extends (ADR 0056).
  record             Record             @relation(fields: [id, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@index([organizationId, ticketId, startsAt])
  @@index([organizationId, entityTypeId])
  @@index([organizationId, stateId])
  @@index([organizationId, alternativeGroupId])
  @@index([organizationId, parentLineId])
}
