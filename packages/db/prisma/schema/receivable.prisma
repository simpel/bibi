/// Lifecycle of a deposit request or an invoice (ADR 0057): only the owned facts. How much of it
/// is paid is never stored; it is derived from its payments (`OPEN` … `OVERPAID`).
enum ReceivableStatus {
  /// Created, not sent to the customer yet; no payment can be requested.
  DRAFT
  /// Sent to the customer; payments can be requested against it.
  SENT
  /// Cancelled; it is no longer owed.
  VOID
}

/// Deposit – a frozen receivable (ADR 0057): an amount requested from the ticket's customer before
/// delivery, with its own description. Owned: amount, currency, description, due date and the
/// lifecycle `status`. Derived: what is paid and its progress (from `Payment`). Never deleted:
/// `status` is its lifecycle.
model Deposit {
  id              String           @id @default(cuid(2))
  organizationId  String
  ticketId        String
  /// What the customer pays for; shown on the payment.
  description     String
  /// Fixed amount in minor units, set once at create.
  amountMinor     Int
  /// VAT per rate of the amount (snapshot at create, ADR 0093): the ticket's priced lines scaled
  /// to the amount, summing to it. `[]` = no VAT (no priced lines, or created before ADR 0093).
  vatRows         Json             @default("[]")
  /// ISO 4217, upper case.
  currency        String           @default("SEK")
  dueDate         DateTime?
  status          ReceivableStatus @default(DRAFT)
  statusChangedAt DateTime         @default(now())
  /// When it was sent to the customer (owned, ADR 0077); kept when it is voided later.
  sentAt          DateTime?
  /// When it was voided (owned, ADR 0077).
  voidedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       String?
  ticket          Ticket           @relation(fields: [ticketId, organizationId], references: [id, organizationId])
  payments        Payment[]
  deductions      InvoiceDeposit[]

  @@unique([id, organizationId])
  @@index([organizationId, ticketId])
}

/// Invoice – a frozen receivable (ADR 0052, 0057): the ticket's priced lines snapshotted as
/// `OrderLine` rows when it is created, like a sent quote, with their totals. Owned: number, due
/// date, lifecycle `status`. Snapshot: lines and totals. Derived: what is paid and its progress.
/// At most one invoice per ticket is not VOID (partial unique index in the migration). Never
/// deleted: `status` is its lifecycle.
model Invoice {
  id                String                  @id @default(cuid(2))
  organizationId    String
  ticketId          String
  /// Per organization, highest + 1; the unique index refuses a concurrent duplicate.
  number            Int
  /// ISO 4217, upper case.
  currency          String                  @default("SEK")
  dueDate           DateTime?
  status            ReceivableStatus        @default(DRAFT)
  statusChangedAt   DateTime                @default(now())
  /// When it was sent to the customer (owned, ADR 0077): the accounting date of its voucher.
  sentAt            DateTime?
  /// When it was voided (owned, ADR 0077): the date of a reversal voucher.
  voidedAt          DateTime?
  /// Sums of the frozen lines in minor units (snapshot).
  totalExclVatMinor Int
  totalInclVatMinor Int
  /// Owned (ADR 0090): where the invoice was raised when it was sent; null = in Bibi only (the
  /// customer pays through a payment Bibi requests).
  provider          InvoiceProvider?
  /// Mirror: the invoice's document number at the provider (Fortnox); null until raised there.
  providerReference String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  createdBy         String?
  ticket            Ticket                  @relation(fields: [ticketId, organizationId], references: [id, organizationId])
  lines             OrderLine[]
  payments          Payment[]
  exportEntries     AccountingExportEntry[]
  /// Paid deposits this invoice deducts (snapshot at create, ADR 0090).
  deductions        InvoiceDeposit[]

  @@unique([id, organizationId])
  @@unique([organizationId, number])
  @@index([organizationId, ticketId])
}

/// InvoiceDeposit – a paid deposit a final invoice deducts (ADR 0090). Snapshot at
/// `invoice.create`: what was paid on the deposit then, never changed afterwards. The invoice's
/// amount due is its total incl. VAT minus these rows; revenue and VAT stay the lines' (the
/// deposit was a customer advance, ADR 0077). A deposit is deducted at most once per invoice.
model InvoiceDeposit {
  id             String   @id @default(cuid(2))
  organizationId String
  invoiceId      String
  depositId      String
  /// Paid on the deposit when the invoice was created, minor units (snapshot).
  amountMinor    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  invoice        Invoice  @relation(fields: [invoiceId, organizationId], references: [id, organizationId])
  deposit        Deposit  @relation(fields: [depositId, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@unique([invoiceId, depositId])
  @@index([organizationId, depositId])
}
