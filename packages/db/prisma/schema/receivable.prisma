/// Lifecycle of a deposit request or an invoice (ADR 0057): only the owned facts. How much of it
/// is paid is never stored; it is derived from its payments (`OPEN` … `OVERPAID`).
enum ReceivableStatus {
  /// Created, not sent to the customer yet; no payment can be requested.
  DRAFT
  /// Sent to the customer; payments can be requested against it.
  SENT
  /// Cancelled; it is no longer owed.
  VOID
}

/// Deposit – a frozen receivable (ADR 0057): an amount requested from the order's customer before
/// delivery, with its own description. Owned: amount, currency, description, due date and the
/// lifecycle `status`. Derived: what is paid and its progress (from `Payment`). Never deleted:
/// `status` is its lifecycle.
model Deposit {
  id              String           @id @default(cuid(2))
  organizationId  String
  orderId        String
  /// What the customer pays for; shown on the payment.
  description     String
  /// Fixed amount in minor units, set once at create.
  amountMinor     Int
  /// VAT per rate of the amount (snapshot at create, ADR 0093): the order's priced lines scaled
  /// to the amount, summing to it. `[]` = no VAT (no priced lines, or created before ADR 0093).
  vatRows         Json             @default("[]")
  /// ISO 4217, upper case.
  currency        String           @default("SEK")
  dueDate         DateTime?
  status          ReceivableStatus @default(DRAFT)
  statusChangedAt DateTime         @default(now())
  /// When it was sent to the customer (owned, ADR 0077); kept when it is voided later.
  sentAt          DateTime?
  /// When it was voided (owned, ADR 0077).
  voidedAt        DateTime?
  /// Owned (ADR 0106): the ledger provider the INVOICE route chose when it was sent, and its
  /// connection, where it is raised as a prepayment invoice; null = in Bibi only.
  provider          Provider?
  connectionId      String?
  /// Mirror: the prepayment invoice's document number at the provider; null until raised there.
  providerReference String?
  /// Mirror: the provider's page for it, if it has one.
  providerUrl       String?
  /// Owned (ADR 0100, 0106): set when crediting the prepayment invoice on void ended without an
  /// answer; the refund retry job reads the credit there and clears it. Null = nothing pending.
  creditPendingAt   DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       String?
  order          Order           @relation(fields: [orderId, organizationId], references: [id, organizationId])
  connection        ProviderConnection? @relation(fields: [connectionId, organizationId], references: [id, organizationId])
  payments        Payment[]
  deductions      InvoiceDeposit[]

  @@unique([id, organizationId])
  @@unique([connectionId, providerReference])
  @@index([organizationId, orderId])
}

/// Invoice – a frozen receivable (ADR 0052, 0057): the order's priced lines snapshotted as
/// `OrderLine` rows when it is created, like a sent quote, with their totals. Owned: due date,
/// lifecycle `status`. Bibi numbers nothing: `providerReference` is its number (ADR 0106). Snapshot: lines and totals. Derived: what is paid and its progress.
/// At most one invoice per order is not VOID (partial unique index in the migration). Never
/// deleted: `status` is its lifecycle.
model Invoice {
  id                String                  @id @default(cuid(2))
  organizationId    String
  orderId          String
  /// ISO 4217, upper case.
  currency          String                  @default("SEK")
  dueDate           DateTime?
  status            ReceivableStatus        @default(DRAFT)
  statusChangedAt   DateTime                @default(now())
  /// When it was sent to the customer (owned, ADR 0077): the accounting date of its voucher.
  sentAt            DateTime?
  /// When it was voided (owned, ADR 0077): the date of a reversal voucher.
  voidedAt          DateTime?
  /// Sums of the frozen lines in minor units (snapshot).
  totalExclVatMinor Int
  totalInclVatMinor Int
  /// Snapshot (ADR 0105): the order's effective buyer's reference when the invoice was created.
  buyerReference    String?
  /// Owned (ADR 0090, 0100): the provider the INVOICE route chose when it was sent, and its
  /// connection; null = in Bibi only (the customer pays through a payment Bibi requests).
  provider          Provider?
  connectionId      String?
  /// Mirror: the invoice's document number at the provider (Fortnox); null until raised there.
  /// Unique per connection (document numbers are per company).
  providerReference String?
  /// Mirror: the provider's page for the invoice, if it has one.
  providerUrl       String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  createdBy         String?
  order            Order                  @relation(fields: [orderId, organizationId], references: [id, organizationId])
  connection        ProviderConnection?     @relation(fields: [connectionId, organizationId], references: [id, organizationId])
  lines             OrderLine[]
  payments          Payment[]
  /// Paid deposits this invoice deducts (snapshot at create, ADR 0090).
  deductions        InvoiceDeposit[]
  creditNotes       CreditNote[]

  @@unique([id, organizationId])
  @@unique([connectionId, providerReference])
  @@index([organizationId, orderId])
}

/// CreditNote – a credit of an invoice (ADR 0052, 0100): the credited lines snapshotted as
/// `OrderLine` rows, like an invoice freezes its lines, with their totals. Owned: reason,
/// `status` (PENDING until the provider confirmed it, then ISSUED, or FAILED) and where it was
/// raised (`provider`, `connectionId`). Snapshot: lines and totals; `amountMinor` is what it
/// credits incl. VAT. Mirrors: `providerReference`, `providerUrl`. Written by `invoice.credit`
/// (ADR 0100). Never deleted: `status` is its lifecycle.
model CreditNote {
  id                String              @id @default(cuid(2))
  organizationId    String
  invoiceId         String
  /// ISO 4217, upper case.
  currency          String              @default("SEK")
  /// What it credits incl. VAT, minor units (snapshot).
  amountMinor       Int
  /// Sums of the frozen lines in minor units (snapshot).
  totalExclVatMinor Int
  totalInclVatMinor Int
  reason            String?
  status            CreditNoteStatus    @default(PENDING)
  /// When the provider confirmed it (owned): the date of its reversal voucher.
  issuedAt          DateTime?
  provider          Provider?
  connectionId      String?
  providerReference String?
  providerUrl       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  createdBy         String?
  invoice           Invoice             @relation(fields: [invoiceId, organizationId], references: [id, organizationId])
  connection        ProviderConnection? @relation(fields: [connectionId, organizationId], references: [id, organizationId])
  lines             OrderLine[]

  @@unique([id, organizationId])
  @@unique([connectionId, providerReference])
  @@index([organizationId, invoiceId])
}

enum CreditNoteStatus {
  PENDING
  ISSUED
  FAILED
}

/// InvoiceDeposit – a paid deposit a final invoice deducts (ADR 0090). Snapshot at
/// `invoice.create`: what was paid on the deposit then, never changed afterwards. The invoice's
/// amount due is its total incl. VAT minus these rows; revenue and VAT stay the lines' (the
/// deposit was a customer advance, ADR 0077). A deposit is deducted at most once per invoice.
model InvoiceDeposit {
  id             String   @id @default(cuid(2))
  organizationId String
  invoiceId      String
  depositId      String
  /// Paid on the deposit when the invoice was created, minor units (snapshot).
  amountMinor    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  invoice        Invoice  @relation(fields: [invoiceId, organizationId], references: [id, organizationId])
  deposit        Deposit  @relation(fields: [depositId, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@unique([invoiceId, depositId])
  @@index([organizationId, depositId])
}
