/// Work order – one version of a ticket's compilation for a responsibility (ADR 0021), e.g. a kitchen order.
/// `content` is a snapshot of the ticket at generation, shaped by its `WorkOrderDefinition`.
/// `changes` marks (★) what differs from `baseVersion`, the last version that was sent before
/// this one; both are null/empty for the first send. A version is never edited or removed:
/// `sentAt` is its only lifecycle, and a changed ticket produces the next version.
model WorkOrder {
  id                String           @id @default(cuid(2))
  organizationId    String
  ticketId          String
  workOrderDefinitionId String
  /// 1, 2, 3, … per ticket and definition.
  version           Int
  /// The receiving responsibility at generation (ADR 0034).
  responsibilityId  String
  /// Snapshot of the ticket's rows the definition includes.
  content           Json
  /// Rows added, changed or removed since `baseVersion` (see core `WorkOrderChange`).
  changes           Json             @default("[]")
  /// Counts that hit the ticket's items at generation (core `WorkOrderMatch`), blocking ones first.
  matches           Json             @default("[]")
  /// True when a match is blocking (an item contains a counted value): `workOrder.send` is refused.
  blocked           Boolean          @default(false)
  /// The last sent version the changes are measured against; null when none was sent before.
  baseVersion       Int?
  /// Projection (ADR 0051): true on the newest version of its ticket and definition. Written only
  /// by core `createVersion`, which clears it on the previous version in the same transaction.
  current           Boolean          @default(false)
  sentAt            DateTime?
  /// User id of whoever sent it.
  sentBy            String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdBy         String?
  ticket            Ticket           @relation(fields: [ticketId, organizationId], references: [id, organizationId])
  workOrderDefinition   WorkOrderDefinition  @relation(fields: [workOrderDefinitionId, organizationId], references: [id, organizationId])
  responsibility    Responsibility   @relation(fields: [responsibilityId, organizationId], references: [id, organizationId])
  /// Who received it: the derived assignee and followers at send time (ADR 0055); empty until sent.
  recipients        WorkOrderRecipient[]
  notifications     Notification[]

  @@unique([id, organizationId])
  @@unique([ticketId, workOrderDefinitionId, version])
  @@index([organizationId, ticketId])
  @@index([organizationId, workOrderDefinitionId])
  @@index([organizationId, responsibilityId])
  @@index([organizationId, current])
}

/// How a recipient took part in a sent work order (ADR 0055).
enum WorkOrderRecipientRole {
  ASSIGNEE
  FOLLOWER
}

/// A member (user id) who received a sent work order (ADR 0055, ADR 0051 snapshot): the responsibility's
/// derived assignee and followers at send time. Written once by `workOrder.send`, never changed, so
/// later changes of defaults or choices do not rewrite who received it. `userId` is a member
/// validated by core, like `AssignmentFollower`. `position` keeps the order.
model WorkOrderRecipient {
  id             String             @id @default(cuid(2))
  organizationId String
  workOrderId        String
  userId         String
  role           WorkOrderRecipientRole
  position       Int
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  createdBy      String?
  workOrder          WorkOrder              @relation(fields: [workOrderId, organizationId], references: [id, organizationId])

  @@unique([workOrderId, userId])
  @@index([organizationId, userId])
}
