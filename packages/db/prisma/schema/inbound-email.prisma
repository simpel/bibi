/// A mail received on a ticket's inbound address (ADR 0012). Written only by the inbound webhook
/// (SYSTEM actor), never edited: append-only. `providerEmailId` is the provider's id (Resend);
/// unique per organization so a redelivered webhook never stores the same mail twice.
/// `attachments` holds metadata only (`{ id, filename, contentType, size }[]`), not the bytes.
model InboundEmail {
  id              String   @id @default(cuid(2))
  organizationId  String
  ticketId        String
  providerEmailId String
  /// The `Message-ID` header, for threading.
  messageId       String?
  fromAddress     String
  toAddresses     String[]
  subject         String?
  text            String?
  html            String?
  attachments     Json     @default("[]")
  receivedAt      DateTime
  createdAt       DateTime @default(now())
  createdBy       String?
  ticket          Ticket   @relation(fields: [ticketId, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@unique([organizationId, providerEmailId])
  @@index([organizationId, ticketId, receivedAt])
}
