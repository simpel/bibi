/// Where the organization gets paid: its Stripe connected account (Accounts v2, ADR 0028). One per
/// organization, created by `paymentAccount.startOnboarding`. Bibi never holds venue funds.
/// `status` mirrors the account's card payments capability and is refreshed by
/// `paymentAccount.sync`; no row at all means "not connected". `stripeAccountId` is null from the
/// committed row until the Stripe call after the commit stored it (ADR 0058); a second
/// `startOnboarding` resumes such a row.
model PaymentAccount {
  id              String               @id @default(cuid(2))
  organizationId  String
  stripeAccountId String?
  status          PaymentAccountStatus @default(ONBOARDING)
  /// Owned (ADR 0090): an admin disconnected Stripe. Nothing can be charged; `status` keeps
  /// mirroring Stripe, and connecting again clears it and resumes the same Stripe account.
  disconnectedAt  DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  createdBy       String?

  @@unique([id, organizationId])
  @@unique([organizationId])
  @@unique([stripeAccountId])
}

enum PaymentAccountStatus {
  /// Created, onboarding not finished (card payments not active yet).
  ONBOARDING
  /// Card payments are active; the venue can be paid.
  ACTIVE
  /// Stripe restricted card payments (e.g. missing or failed verification).
  RESTRICTED
}

/// PaymentSettings – how the organization takes order money (ADR 0090). One row per organization,
/// created on the first `paymentSettings.update`; no row = no deposit rule and the payment
/// operator and invoice provider follow what is connected. Owned: every column. Nothing is copied onto deposits: a
/// deposit keeps the amount it was created with (ADR 0057).
model PaymentSettings {
  id                  String           @id @default(cuid(2))
  organizationId      String           @unique
  /// Share of the order's total incl. VAT asked as a deposit, 1–100; null = no deposit rule.
  depositPercent      Int?
  /// A order whose total incl. VAT is below this (minor units) is paid in full up front.
  depositMinimumMinor Int?
  /// Where invoices are raised when both Stripe and Fortnox are connected; null = whichever is.
  invoiceProvider     InvoiceProvider?
  /// The payment operator that takes card payments for orders; null = the one that is connected.
  paymentOperator     PaymentOperator?
  status              RecordStatus     @default(ACTIVE)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  createdBy           String?

  @@unique([id, organizationId])
}

/// The company that processes an organization's card payments (ADR 0090). More come later.
enum PaymentOperator {
  STRIPE
}

/// The system an organization raises its invoices in (ADR 0090).
enum InvoiceProvider {
  STRIPE
  FORTNOX
}
