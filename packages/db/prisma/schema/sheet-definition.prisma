/// Sheet definition (ADR 0021) – an organization's own sheet, e.g. Kitchen order or Brewing order.
/// It names the item types and fields a sheet includes, the lists whose requirements it includes
/// and the role it goes to. The referenced ids are validated by core (`sheetDefinition.*`), and
/// archiving a referenced type, field, list or role is refused while a definition uses it.
model SheetDefinition {
  id             String       @id @default(cuid(2))
  organizationId String
  name           String
  /// Item types (`EntityType` of base ITEM) whose items appear on the sheet.
  entityTypeIds  String[]
  /// Fields (`FieldDefinition` of those types) shown per item.
  fieldIds       String[]
  /// Lists (`Vocabulary`) whose requirements are counted on the sheet.
  vocabularyIds  String[]
  /// The receiving role: an `OrganizationRole` id, or `owner` for the fixed role.
  roleId         String
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?
  /// The versions generated from this definition.
  sheets         Sheet[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
}
