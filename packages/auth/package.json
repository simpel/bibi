{
  "name": "@bibi/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./reserved-slugs": "./src/organization/reserved-slugs.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "auth:generate": "auth generate --config src/cli-config.ts --output ../db/prisma/schema/auth.prisma --yes",
    "grant-superadmin": "tsx --env-file-if-exists=../../.env src/platform/grant-superadmin-cli.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.7",
    "@better-auth/cimd": "1.7.7",
    "@better-auth/core": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@better-auth/utils": "0.4.2",
    "@bibi/config": "workspace:*",
    "@bibi/core": "workspace:*",
    "@bibi/db": "workspace:*",
    "@bibi/logger": "workspace:*",
    "@bibi/mail": "workspace:*",
    "@paralleldrive/cuid2": "3.3.0",
    "better-auth": "1.7.7",
    "better-call": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "auth": "1.7.7",
    "react": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "peerDependencies": {
    "react": "19.3.0"
  }
}
