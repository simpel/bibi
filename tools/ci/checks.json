{
  "comment": "The single definition of the checks. Used by CI (.github/workflows/ci.yml) and locally by the implement skill through verify.mjs. stage: fast = always all reported; slow = run when every fast check passed; last = run when everything before passed. paths: regexes over changed files; the check runs in auto mode only when one matches (--all ignores them). job: the check runs in that CI job (not in check) and is skipped by --all; auto mode still runs it locally. light: part of --light (documentation and decision orders). needs: postgres = a database must be up.",
  "checks": [
    { "id": "lint", "name": "pnpm lint", "command": "pnpm lint", "stage": "fast", "light": true },
    {
      "id": "structure",
      "name": "pnpm check:structure",
      "command": "pnpm check:structure",
      "stage": "fast",
      "light": true
    },
    { "id": "typecheck", "name": "pnpm typecheck", "command": "pnpm typecheck", "stage": "fast" },
    {
      "id": "migrate",
      "name": "pnpm db:migrate",
      "command": "pnpm db:migrate",
      "stage": "slow",
      "needs": "postgres"
    },
    {
      "id": "test",
      "name": "pnpm test",
      "command": "pnpm test",
      "stage": "slow",
      "needs": "postgres"
    },
    {
      "id": "build",
      "name": "pnpm build",
      "command": "pnpm build",
      "stage": "last",
      "job": "e2e",
      "paths": [
        "^apps/web/",
        "^apps/mcp/",
        "^packages/(ui|i18n|ai|graphql|api|auth)/",
        "^packages/core/src/(schemas|index)\\.ts$",
        "^packages/core/package\\.json$",
        "^(package\\.json|pnpm-lock\\.yaml|pnpm-workspace\\.yaml|turbo\\.json|tsconfig[^/]*\\.json)$"
      ]
    },
    {
      "id": "storybook",
      "name": "build-storybook",
      "command": "pnpm --filter @bibi/ui build-storybook",
      "stage": "last",
      "job": "storybook",
      "paths": ["^packages/ui/", "^(package\\.json|pnpm-lock\\.yaml)$"]
    }
  ]
}
